        <div class="nav-section-label px-3 mt-3">ADMIN</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/conversations">
                <span class="bi bi-chat-dots" aria-hidden="true"></span> Conversations
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/prompts">
                <span class="bi bi-file-text" aria-hidden="true"></span> Prompts
            </NavLink>
        </div>
    </nav>
