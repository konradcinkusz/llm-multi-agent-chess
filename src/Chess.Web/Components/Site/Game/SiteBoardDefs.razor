@using Chess.Web.Components.Shared

@* The parts every board of a game page shares, written once per page: the checkerboard, the 16 coordinate labels and one
   group per piece. A board then only places its pieces and highlights (SiteBoard), which keeps a board per ply small (03 §11).
   A piece is a group, not a symbol: a use of a group needs only x and y, where a use of a symbol also needs width and height. *@
<svg class="site-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
        <pattern id="site-checker" width="200" height="200" patternUnits="userSpaceOnUse">
            <rect width="200" height="200" fill="@LightSquare" />
            <rect x="100" width="100" height="100" fill="@DarkSquare" />
            <rect y="100" width="100" height="100" fill="@DarkSquare" />
        </pattern>
        <g id="@CoordinatesId" class="coord">
            @for (var row = 0; row < 8; row++)
            {
                var rank = 7 - row;
                @CoordinateText(6, row * 100 + 18, null, (rank + 1).ToString(), rank % 2 == 0 ? LightSquare : DarkSquare)
            }
            @for (var file = 0; file < 8; file++)
            {
                @CoordinateText(file * 100 + 94, 794, "end", ((char)('a' + file)).ToString(), file % 2 == 0 ? LightSquare : DarkSquare)
            }
        </g>
        @foreach (var piece in Pieces)
        {
            <g id="@SiteBoardDefs.PieceId(piece)">
                @Glyph(FenBoard.Symbol(piece))
            </g>
        }
    </defs>
</svg>

@code {
    /// <summary>The wood palette of the boards, as ChessBoardSvg draws them (07 §1, a documented exception).</summary>
    public const string LightSquare = "#f0d9b5";

    public const string DarkSquare = "#b58863";

    /// <summary>The FEN letters of the pieces: white upper case, black lower case.</summary>
    private const string Pieces = "KQRBNPkqrbnp";

    /// <summary>The id of a piece's group, which a board references with <c>&lt;use href&gt;</c>.</summary>
    public static string PieceId(char piece) => "site-piece-" + piece;

    /// <summary>The id of the group of the 16 coordinate labels every board shows.</summary>
    public const string CoordinatesId = "site-coords";

    private static RenderFragment CoordinateText(int x, int y, string? anchor, string content, string fill) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", x);
        builder.AddAttribute(2, "y", y);
        if (anchor is not null)
        {
            builder.AddAttribute(3, "text-anchor", anchor);
        }
        builder.AddAttribute(4, "font-size", 16);
        builder.AddAttribute(5, "fill", fill);
        builder.AddContent(6, content);
        builder.CloseElement();
    };

    private static RenderFragment Glyph(string symbol) => builder =>
    {
        // Razor reserves the <text> tag, so the SVG text element is built directly, as ChessBoardSvg does.
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", 50);
        builder.AddAttribute(2, "y", 50);
        builder.AddAttribute(3, "text-anchor", "middle");
        builder.AddAttribute(4, "dominant-baseline", "central");
        builder.AddAttribute(5, "font-size", 80);
        builder.AddAttribute(6, "fill", "#1a1a1a");
        builder.AddContent(7, symbol);
        builder.CloseElement();
    };
}
