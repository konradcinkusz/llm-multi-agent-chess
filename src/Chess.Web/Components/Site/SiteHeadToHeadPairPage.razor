@using Chess.Web.Components.Pages.Results
@using Chess.Web.Components.Pages.Games
@using Chess.Web.Site

<SiteLayout Title="@($"{Pair.A} vs {Pair.B}")" Frame="Frame" Active="head-to-head">
    <p class="back"><a href="@Frame.Link(SitePaths.HeadToHead)">← All pairs</a></p>

    <div class="page-header">
        <h1>@Pair.A vs @Pair.B</h1>
        <p class="page-lede">Relative quality of the two models, and every game they played against each other.</p>
    </div>

    <div class="stack-lg">
        <section class="card" data-section="reading" aria-labelledby="reading-heading">
            <h2 id="reading-heading" class="card-title">Reading</h2>
            <p class="muted">Relative quality, RQC</p>
            <p class="h2h-hero">
                <span class="h2h-rqc">@ResultsModel.Number(Pair.Cell.Rqc, "0.00")</span> <span>for @Pair.A</span>
                <span class="muted">(95 % interval @ResultsModel.Number(Pair.Cell.RqcLow, "0.00") – @ResultsModel.Number(Pair.Cell.RqcHigh, "0.00"))</span>
            </p>
            <p><strong>@Pair.Reading</strong></p>
            <p class="muted">
                The coefficient uses every game in the arena, not only the games between these two.
                The direct record is shown next to it, never instead of it.
            </p>

            <dl class="h2h-figures">
                <dt>Expected score</dt>
                <dd>@ResultsModel.Number(Pair.Cell.ExpectedScore, "0.00") for @Pair.A</dd>

                <dt>Quality share</dt>
                <dd>@ResultsModel.Number(Pair.Cell.QualityShare, "0.00") for @Pair.A</dd>

                <dt>Elo-equivalent</dt>
                <dd>@ResultsModel.Number(Pair.Cell.EloEquivalent, "+0.0;-0.0;0.0") Elo for @Pair.A against @Pair.B</dd>

                <dt>Direct record</dt>
                <dd>@Pair.DirectRecord</dd>
            </dl>
        </section>

        <section class="card" data-section="direct-games" aria-labelledby="direct-games-heading">
            <h2 id="direct-games-heading" class="card-title">Direct games</h2>
            @if (Pair.Games.Count == 0)
            {
                <p class="muted">No games between these two models yet.</p>
            }
            else
            {
                <div class="table-wrap table-compact">
                    <table class="h2h-games">
                        <thead>
                            <tr>
                                <th scope="col">Played (UTC)</th>
                                <th scope="col">White</th>
                                <th scope="col">Black</th>
                                <th scope="col">Result</th>
                                <th scope="col">Rated</th>
                                <th scope="col" class="num">@Pair.A score</th>
                                <th scope="col"><span class="visually-hidden">Game</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var game in Pair.Games)
                            {
                                <tr>
                                    <td>@GameFormat.Compact(game.CreatedAt)</td>
                                    <td>@game.White.ModelId</td>
                                    <td>@game.Black.ModelId</td>
                                    <td><span class="badge @GameFormat.ResultTone(game.Result)">@game.Result</span></td>
                                    <td>@(game.Rated ? "yes" : "no")</td>
                                    <td class="num">@ScoreText(Chess.Web.Components.Pages.HeadToHead.DirectGames.ScoreFor(game, Pair.A))</td>
                                    <td><a href="@Frame.Link(SitePaths.Game(game.Id))">Game</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</SiteLayout>

@code {
    [Parameter, EditorRequired]
    public SiteFrame Frame { get; set; } = null!;

    [Parameter, EditorRequired]
    public SitePair Pair { get; set; } = null!;

    private static string ScoreText(double? score) => score is { } s ? ResultsModel.Number(s, "0.#") : "–";
}
