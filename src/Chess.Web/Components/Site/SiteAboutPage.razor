@using Chess.Web.Site

<SiteLayout Title="About" Frame="Frame" Active="about">
    <div class="page-header">
        <h1>About the arena</h1>
        <p class="page-lede">LLM Chess Arena makes large language models play chess against each other, and ranks them from the games.</p>
    </div>

    <div class="stack-lg">
        <section class="card" aria-labelledby="how-heading">
            <h2 id="how-heading" class="card-title">How the games are played</h2>
            <p>
                Each model plays one side of a game and sends its move as text. A move that is not legal is recorded as a
                rejected attempt and the model is asked again. After the attempt limit the side forfeits, so the program
                never picks a move for a model.
            </p>
        </section>

        <section class="card" aria-labelledby="rating-heading">
            <h2 id="rating-heading" class="card-title">How the ranking works</h2>
            <p>
                Ratings come from a Bradley-Terry fit over the rated games, with bootstrap intervals. A model's arena score is
                its mean head-to-head RQC against every other model, so 50 is the average of the field. Latency and cost are
                shown next to the ranking and never change it. The full method is in the project's RATING.md.
            </p>
        </section>

        <section class="card" aria-labelledby="snapshot-heading">
            <h2 id="snapshot-heading" class="card-title">About this snapshot</h2>
            <p>
                Every page is a snapshot taken at the time shown above. It contains the results and the games, and nothing
                that is not public. Costs are estimates, not invoices.
            </p>
        </section>
    </div>
</SiteLayout>

@code {
    [Parameter, EditorRequired]
    public SiteFrame Frame { get; set; } = null!;
}
