@using Chess.Web.Api
@inject ArenaApiClient Api

<div class="status-strip" role="status">
    @if (status is not null)
    {
        <span class="status-item" data-service="copilot" title="@status.CopilotDetail"><span class="dot dot-@CopilotTone(status.Copilot)" aria-hidden="true"></span>Copilot: <strong>@status.Copilot</strong> <span class="status-detail">(@status.CopilotDetail)</span></span>
        <span class="status-item" data-service="database"><span class="dot dot-@ServiceTone(status.Database)" aria-hidden="true"></span>Database: <strong>@status.Database</strong></span>
        <span class="status-item" data-service="stockfish" title="@StockfishTitle(status.Stockfish)"><span class="dot dot-@ServiceTone(status.Stockfish)" aria-hidden="true"></span>Stockfish: <strong>@status.Stockfish</strong></span>
    }
    else if (unavailable)
    {
        <span class="status-error">API unavailable: @detail</span>
    }
    else
    {
        <span>Checking services…</span>
    }
</div>

@code {
    private StatusDto? status;
    private bool unavailable;
    private string? detail;

    // The Copilot state is the gateway's own (03 §8); the dot colour follows 07 §5.
    internal static string CopilotTone(string state) => state switch
    {
        "Ready" => "success",
        "Fake" => "accent",
        "NotAuthenticated" => "warning",
        "Unavailable" => "danger",
        _ => "neutral",
    };

    // Database reports a health status; Stockfish reports available | absent (03 §8). An absent Stockfish is
    // neutral: it is optional, not broken.
    internal static string ServiceTone(string status) => status switch
    {
        "healthy" or "available" => "success",
        "degraded" => "warning",
        "unhealthy" => "danger",
        _ => "neutral",
    };

    internal static string? StockfishTitle(string status) => status == "absent" ? "move quality disabled" : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            status = await Api.GetStatusAsync();
        }
        catch (Exception ex)
        {
            // The strip reports on the API; it must never take the page down with it.
            unavailable = true;
            detail = ex.Message;
        }
    }
}
