@page "/head-to-head"
@using System.Globalization
@using System.Net
@using Chess.Web.Api
@using Chess.Web.Components.Pages.Shared
@inject ArenaApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Head-to-head · LLM Chess Arena</PageTitle>

<div class="page-header">
    <h1>Head-to-head</h1>
    <p class="page-lede">Compare two models: how strong each is against the other, and what their direct games say.</p>
</div>

@if (players is null && modelsError is null)
{
    <p class="muted">Loading models…</p>
}
else if (modelsError is not null)
{
    <p class="status-error" role="alert">Could not load the models: @modelsError</p>
}
else
{
    <div class="stack-lg">
        <div class="field-row">
            <label class="field">
                Model A
                <select id="model-a" @bind="a" @bind:after="PairChanged">
                    @foreach (var player in PickerOptions(a))
                    {
                        <option value="@player.Id">@player.Label</option>
                    }
                </select>
            </label>
            <label class="field">
                Model B
                <select id="model-b" @bind="b" @bind:after="PairChanged">
                    @foreach (var player in PickerOptions(b))
                    {
                        <option value="@player.Id">@player.Label</option>
                    }
                </select>
            </label>
        </div>

        @if (string.IsNullOrEmpty(a) || string.IsNullOrEmpty(b))
        {
            <p class="muted">At least two models are needed to compare.</p>
        }
        else if (a == b)
        {
            <p class="muted">Choose two different models to compare.</p>
        }
        else if (pairError is not null)
        {
            <p class="status-error" role="alert">@pairError</p>
        }
        else if (pair is null)
        {
            <p class="muted">Loading the comparison…</p>
        }
        else
        {
            <section class="card" aria-labelledby="h2h-reading">
                <h2 id="h2h-reading" class="card-title">Reading</h2>
                <p class="h2h-label muted">Relative quality, RQC</p>
                <p class="h2h-hero">
                    <span class="h2h-rqc">@Format(pair.Rqc)</span> <span class="h2h-for">for @pair.A</span>
                    <span class="muted">(95 % interval @Format(pair.RqcLow) – @Format(pair.RqcHigh))</span>
                </p>
                <p class="h2h-reading"><strong>@VerbalReading.Sentence(pair, bothEstablished)</strong></p>
                <p class="muted h2h-note">
                    The coefficient uses every game in the arena, not only the games between these two.
                    The direct record is shown next to it, never instead of it.
                </p>

                <dl class="h2h-figures">
                    <dt>Expected score</dt>
                    <dd>@Format(pair.ExpectedScore) for @pair.A</dd>

                    <dt>Quality share</dt>
                    <dd>@Format(pair.QualityShare) for @pair.A</dd>

                    <dt>Elo-equivalent</dt>
                    <dd>@EloText(pair)</dd>

                    <dt>Direct record</dt>
                    <dd>@DirectRecordText(pair)</dd>
                </dl>
            </section>

            @if (directGames is not null)
            {
                <section class="card" aria-labelledby="h2h-games">
                    <h2 id="h2h-games" class="card-title">Direct games</h2>
                    @if (directGames.Count == 0)
                    {
                        <p class="muted">No games between these two models yet.</p>
                    }
                    else
                    {
                        <div class="table-wrap table-compact" tabindex="0" role="region" aria-label="Direct games (scrollable table)">
                            <table class="h2h-games">
                                <thead>
                                    <tr>
                                        <th scope="col">Created</th>
                                        <th scope="col">White</th>
                                        <th scope="col">Black</th>
                                        <th scope="col">Result</th>
                                        <th scope="col">Rated</th>
                                        <th scope="col" class="num">@pair.A score</th>
                                        <th scope="col"><span class="visually-hidden">Game</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var game in directGames)
                                    {
                                        <tr @key="game.Id">
                                            <td>@game.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</td>
                                            <td>@game.White.ModelId</td>
                                            <td>@game.Black.ModelId</td>
                                            <td>@(game.State == "finished" ? game.Result : game.State)</td>
                                            <td>@(game.Rated ? "yes" : "no")</td>
                                            <td class="num">@ScoreText(DirectGames.ScoreFor(game, pair.A))</td>
                                            <td><a href="/games/@game.Id">Open</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        }
    </div>
}

@code {
    // Enough to cover the direct games of a pair in one request for a normal arena; more pages are fetched when there are more.
    private const int GamesPageSize = 100;

    private IReadOnlyList<PlayerOption>? players;
    private string? modelsError;
    private string? a;
    private string? b;
    private (string?, string?)? compared;
    private PairwiseCoefficient? pair;
    private bool bothEstablished;
    private string? pairError;
    private IReadOnlyList<GameSummaryDto>? directGames;
    private CancellationTokenSource? cts;

    /// <summary>The pair lives in the address (<c>?a=&amp;b=</c>), so a link and Back show the same comparison.</summary>
    [SupplyParameterFromQuery(Name = "a")]
    public string? AQuery { get; set; }

    [SupplyParameterFromQuery(Name = "b")]
    public string? BQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The players of the ratings, as the API ranks them (model, effort and style): the pair is asked for by player id.
            players = await PlayerOptions.LoadAsync(Api, includeCatalogue: false, CancellationToken.None);
        }
        catch (Exception ex)
        {
            // The page reports the failure; it must not take the app down with it.
            modelsError = ApiFailure.Describe(ex);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (players is null)
        {
            return;
        }

        // Without a pair in the address the two best players are compared.
        a = string.IsNullOrEmpty(AQuery) ? players.FirstOrDefault()?.Id : AQuery;
        b = string.IsNullOrEmpty(BQuery) ? players.Skip(1).FirstOrDefault()?.Id : BQuery;
        if (compared != (a, b))
        {
            compared = (a, b);
            await CompareAsync();
        }
    }

    /// <summary>The players to pick from, and the one the address names when no list knows it, so the picker can show it.</summary>
    private IReadOnlyList<PlayerOption> PickerOptions(string? current) =>
        string.IsNullOrEmpty(current) || players!.Any(player => player.Id == current)
            ? players!
            : [.. players!, new PlayerOption(current, current)];

    /// <summary>Writes the picked pair into the address (replacing the entry), which loads the comparison.</summary>
    private void PairChanged() =>
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["a"] = a, ["b"] = b }),
            replace: true);

    /// <summary>Loads the coefficient for the two picked models. A newer pick cancels the one still running.</summary>
    private async Task CompareAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var ct = cts.Token;

        pair = null;
        bothEstablished = false;
        pairError = null;
        directGames = null;

        var first = a;
        var second = b;
        if (string.IsNullOrEmpty(first) || string.IsNullOrEmpty(second) || first == second)
        {
            return;
        }

        try
        {
            var coefficient = await Api.GetPairwiseAsync(first, second, ct);
            // The provisional flags come from the leaderboard: a lead needs both models to have enough games (RATING.md §5).
            var board = await Api.GetLeaderboardAsync(ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            pair = coefficient;
            bothEstablished = Significance.BothEstablished(board.Models, first, second);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            pairError = "One of these models has no rating data yet.";
            return;
        }
        catch (Exception ex)
        {
            pairError = $"Could not load the comparison: {ApiFailure.Describe(ex)}";
            return;
        }

        // The direct-games list needs GET /api/games. When that endpoint does not answer, the list is left out and the coefficient still shows.
        try
        {
            var games = await LoadDirectGamesAsync(first, second, ct);
            if (!ct.IsCancellationRequested)
            {
                directGames = games;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            directGames = null;
        }
    }

    private async Task<IReadOnlyList<GameSummaryDto>> LoadDirectGamesAsync(string first, string second, CancellationToken ct)
    {
        // The archive filters by one model, so the pair is cut out of the games of the first model.
        var games = new List<GameSummaryDto>();
        for (var page = 1; ; page++)
        {
            var result = await Api.GetGamesAsync(page, GamesPageSize, first, null, ct);
            games.AddRange(result.Items);
            if (result.Items.Count == 0 || games.Count >= result.Total)
            {
                break;
            }
        }

        return DirectGames.Between(games, first, second);
    }

    private static string Format(double value) => NumberText.Fixed(value, "0.00");

    private static string ScoreText(double? score) => score is { } s ? s.ToString("0.#", CultureInfo.InvariantCulture) : "–";

    private string EloText(PairwiseCoefficient p) =>
        $"{NumberText.Signed(p.EloEquivalent, "0.0")} Elo for {p.A} against {p.B}";

    private static string DirectRecordText(PairwiseCoefficient p)
    {
        if (p.HeadToHeadGames == 0 || p.HeadToHeadScore is not { } score)
        {
            return "No direct games yet.";
        }

        return $"{p.HeadToHeadGames} direct {(p.HeadToHeadGames == 1 ? "game" : "games")}; {p.A} scored {Format(score)} per game.";
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}
