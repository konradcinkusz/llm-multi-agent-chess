@page "/broadcast"
@layout BroadcastLayout
@using System.Globalization
@using Microsoft.Extensions.Logging
@using Chess.Web.Api
@using Chess.Web.Components.Layout
@using Chess.Web.Components.Pages.Play
@using Chess.Web.Components.Shared
@implements IDisposable
@inject ArenaApiClient Api
@inject GameEventsClient Events
@inject IHttpClientFactory HttpClients
@inject ILogger<LiveBroadcastPage> Log

<PageTitle>LLM Chess 24h · Broadcast</PageTitle>

<div class="bc-stage @ThemeClass @ViewClass" data-testid="broadcast-stage">
    <header class="bc-head">
        <a class="bc-github" href="https://github.com/konradcinkusz/llm-multi-agent-chess" target="_blank" rel="noopener noreferrer" data-testid="broadcast-github">github.com/konradcinkusz/llm-multi-agent-chess</a>
        <div class="bc-head-right">
            @if (_now is null || _linkError is not null)
            {
                <p class="bc-link" data-testid="broadcast-link">@LinkText</p>
            }
            <p class="bc-clock" data-testid="broadcast-clock">@Time.GetLocalNow().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</p>
        </div>
    </header>

    <section class="bc-game" aria-label="Current game">
        <div class="bc-player @(ThinkingSide == "black" ? "bc-thinking" : null)" data-testid="broadcast-black">
            <span class="bc-swatch" style="background: @ColourOf(ShownBlack?.ModelId)"></span>
            <span>@SideLabel(ShownBlack)</span>
            @if (ThinkingSide == "black") { <span class="bc-dots" aria-label="thinking"><i></i><i></i><i></i></span> }
        </div>

        <div class="bc-board-frame">
            <div class="bc-board" data-testid="broadcast-board">
                <ChessBoardSvg Fen="@BoardFen" LastMove="@LastMove" />
            </div>

            @if (_now?.Notice is { } notice)
            {
                <div class="bc-card bc-notice" data-testid="broadcast-notice" role="status">
                    <h2>Technical break</h2>
                    <p>@notice</p>
                </div>
            }
            else if (InIntermission)
            {
                <div class="bc-card bc-intermission" data-testid="broadcast-intermission" role="status">
                    <h2>@InterludeTitle</h2>
                    <p>@IntermissionLine</p>
                    @if (Countdown is { } left)
                    {
                        <p class="bc-countdown" data-testid="broadcast-countdown">Starts in @left</p>
                    }
                    <div class="bc-loader" aria-hidden="true"><i></i></div>
                </div>
            }
        </div>

        <div class="bc-player @(ThinkingSide == "white" ? "bc-thinking" : null)" data-testid="broadcast-white">
            <span class="bc-swatch" style="background: @ColourOf(ShownWhite?.ModelId)"></span>
            <span>@SideLabel(ShownWhite)</span>
            @if (ThinkingSide == "white") { <span class="bc-dots" aria-label="thinking"><i></i><i></i><i></i></span> }
        </div>

    </section>

    @* Two side columns on the 16:9 stage. On a portrait screen they dissolve (display: contents) into the stage grid. *@
    <div class="bc-col bc-col-a">
        <p class="bc-status" data-testid="broadcast-status" role="status">@StatusLine</p>

        <section class="bc-panel bc-moves-panel" data-testid="broadcast-moves" aria-label="Moves">
            <h2>Moves</h2>
            <ol class="bc-moves">
                @foreach (var row in MoveTail)
                {
                    <li data-move="@row.Number">
                        <span class="bc-num-move">@(row.Number).</span>
                        <span class="bc-san">@row.White</span>
                        <span class="bc-san">@row.Black</span>
                    </li>
                }
            </ol>
        </section>

        <section class="bc-panel bc-next-panel" data-testid="broadcast-upnext" aria-label="Up next">
            <h2>Up next</h2>
            @if (_now is { Next.Count: > 0 } now)
            {
                <ol class="bc-next">
                    @foreach (var slot in now.Next)
                    {
                        <li>
                            <span class="bc-time">@LiveBroadcastView.StartLabel(slot.PlannedStart)</span>
                            <span class="bc-name">@SideLabel(slot.White) vs @SideLabel(slot.Black)</span>
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="bc-muted">Nothing scheduled after this game.</p>
            }
        </section>

    </div>
</div>

@code {
    /// <summary>
    /// The name <c>AddHttpClient&lt;ArenaApiClient&gt;</c> registers its client under. The broadcast reads use that client's
    /// base address, service discovery and resilience handler, so they need no registration of their own.
    /// </summary>
    private const string ArenaClientName = "ArenaApiClient";

    /// <summary>The first wait before reconnecting a stream that closed early. It doubles up to <see cref="MaxReconnectDelay"/>.</summary>
    private static readonly TimeSpan MaxReconnectDelay = TimeSpan.FromSeconds(30);

    /// <summary>The replay pace when the schedule sends none: one move every three seconds.</summary>
    private const int DefaultMoveDelayMs = 3000;

    /// <summary>The <c>?theme=</c> option: <c>light</c> for a light background, anything else is the dark default.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "theme")]
    public string? Theme { get; set; }

    /// <summary>The <c>?view=</c> option: <c>mobile</c> forces the portrait (phone) layout on any screen; otherwise a narrow portrait viewport gets it.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    /// <summary>How often the page reads <c>/api/broadcast/now</c>.</summary>
    [Parameter]
    public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(5);

    /// <summary>The first wait before reconnecting a live stream.</summary>
    [Parameter]
    public TimeSpan ReconnectDelay { get; set; } = TimeSpan.FromSeconds(2);

    /// <summary>
    /// How long one poll read may take. A read that hangs (a database retry, a machine that slept) is cut here, so the next
    /// poll goes out well before the HttpClient timeout of 100 s.
    /// </summary>
    [Parameter]
    public TimeSpan RequestTimeout { get; set; } = TimeSpan.FromSeconds(20);

    /// <summary>How long a replay's final position stays on the board before the next stored game starts.</summary>
    [Parameter]
    public TimeSpan ReplayHold { get; set; } = TimeSpan.FromSeconds(10);

    /// <summary>The clock of the header, the countdown and the start times. The system clock unless a test sets one.</summary>
    [Parameter]
    public TimeProvider? Clock { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _follow;
    private LiveBroadcastClient? _broadcast;

    private IReadOnlyList<ModelDto> _models = [];
    private IReadOnlyList<string> _modelIds = [];
    private LeaderboardDto? _leaderboard;
    private LiveNowNext? _now;
    private string? _linkError;
    private LiveGame? _live;
    private RequestQueueDto? _queue;

    /// <summary>True once the queue has been read, even when the read failed. A replay waits for it, so an empty queue is never assumed.</summary>
    private bool _queueKnown;
    private PacingProfile? _pacing;

    /// <summary>The replay loop while the queue is empty. Null when no replay is wanted or the API gave none.</summary>
    private CancellationTokenSource? _replays;

    /// <summary>True while a stored game is on the board, so the game header and status say it is a replay.</summary>
    private bool _replaying;

    private Guid? _lastReplay;

    private TimeProvider Time => Clock ?? TimeProvider.System;

    private bool IsLight => string.Equals(Theme, "light", StringComparison.OrdinalIgnoreCase);

    /// <summary>A request or a replay is on the board, so the intermission card must not cover it.</summary>
    // A replay counts once its game is on the board (_replaying), not when its loop starts looking for one: the loop may find
    // none, and hiding the intermission meanwhile made it flicker.
    private bool ShowsRequestOrReplay => _replaying || _queue?.Playing?.GameId is not null;

    private string ThemeClass => IsLight ? "bc-light" : "bc-dark";

    private string ViewClass => string.Equals(View, "mobile", StringComparison.OrdinalIgnoreCase) ? "bc-portrait" : string.Empty;

    private LiveBroadcastClient Broadcast => _broadcast ??= new LiveBroadcastClient(HttpClients.CreateClient(ArenaClientName));

    private IReadOnlyList<MoveRow> MoveTail => _live is null || UpNext is not null ? [] : LiveBroadcastView.MoveTail(_live.Moves);

    private bool InIntermission => _now is { Current: null, Notice: null } && !ShowsRequestOrReplay;

    /// <summary>Between games the board is already set up for the next one, with its players.</summary>
    private LiveSlot? UpNext => InIntermission && _now is { Next.Count: > 0 } now ? now.Next[0] : null;

    private PlayerSpec? ShownBlack => UpNext?.Black ?? _live?.Summary.Black;

    private PlayerSpec? ShownWhite => UpNext?.White ?? _live?.Summary.White;

    private string? Countdown
    {
        get
        {
            if (UpNext is not { } next)
            {
                return null;
            }

            return LiveBroadcastView.CountdownText(next.PlannedStart - Time.GetUtcNow());
        }
    }

    private string BoardFen => UpNext is not null ? LiveGame.StartFen : _live?.CurrentFen ?? LiveGame.StartFen;

    /// <summary>The square pair of the last move, drawn as the board highlight.</summary>
    private BoardMove? LastMove => UpNext is null && _live is { Moves.Count: > 0 } live
        ? LiveBoardHighlight.Of(live.Moves.Count > 1 ? live.Moves[^2].FenAfter : LiveGame.StartFen, live.Moves[^1].FenAfter, live.Moves[^1].San)
        : null;

    private string LinkText => _now is null && _linkError is null ? "Connecting to the arena…" : "Reconnecting to the arena…";

    private string? ThinkingSide => !_replaying && _live is { Outcome: null, Thinking: { } t } ? (t.Ply % 2 == 1 ? "white" : "black") : null;

    private string StatusLine
    {
        get
        {
            if (_replaying)
            {
                return "Replay of a past game";
            }

            var line = _live switch
            {
                null => string.Empty,
                { Outcome: { } outcome } => $"Result {outcome.Result}",
                { Thinking: { } thinking } => $"Move {(thinking.Ply + 1) / 2} · {ModelName(thinking.ModelId)} is thinking…",
                _ => "Game in progress.",
            };
            return LiveRequestView.RequestedBy(_queue, _live?.GameId) is { } payer && line.Length > 0
                ? $"Requested by {payer} · {line}"
                : line;
        }
    }

    /// <summary>The heading of the card shown while no game is on: off air, paused, or between two games.</summary>
    private string InterludeTitle => _now?.Status switch
    {
        "idle" => "Off air",
        "paused" => "Paused",
        _ => "Intermission",
    };

    private string IntermissionLine
    {
        get
        {
            if (_now is { Next.Count: > 0 } now)
            {
                var next = now.Next[0];
                return $"Next game at {LiveBroadcastView.StartLabel(next.PlannedStart)}: {SideLabel(next.White)} vs {SideLabel(next.Black)}.";
            }

            return _now?.Status switch
            {
                "idle" => "No broadcast is running.",
                "paused" => "The broadcast will continue when it is resumed.",
                _ => "The schedule has no further games.",
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _models = await Api.GetModelsAsync();
        }
        catch (HttpRequestException)
        {
            // Names fall back to the model ids until the next start.
        }
        catch (OperationCanceledException)
        {
            // An HttpClient timeout surfaces as a cancellation. The page cannot be left without its loops, so go on.
        }

        _modelIds = _models.Select(model => model.Id).Order(StringComparer.Ordinal).ToList();
        await RefreshLeaderboardAsync(_lifetime.Token);

        _ = Observe(PollNowAsync(_lifetime.Token), "the poll loop");
        _ = Observe(TickClockAsync(_lifetime.Token), "the clock");
    }

    /// <summary>
    /// Awaits a task nobody else awaits, so that a failure is logged instead of vanishing in a discarded task. The loops that
    /// keep the stage alive catch their own failures; this is the net under them.
    /// </summary>
    private async Task Observe(Task task, string what)
    {
        try
        {
            await task;
        }
        catch (Exception ex) when (!_lifetime.IsCancellationRequested)
        {
            Log.LogError(ex, "The broadcast page stopped {What}.", what);
        }
        catch (Exception)
        {
            // The page has gone.
        }
    }

    /// <summary>
    /// Polls the broadcast and the request queue until the page goes. A failed round (an HttpClient timeout surfaces as a
    /// <see cref="TaskCanceledException"/> while the page's token is not cancelled) is logged and the loop goes on: the
    /// stage is on screen for a day and must not freeze on one bad read.
    /// </summary>
    private async Task PollNowAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            do
            {
                try
                {
                    await RefreshNowAsync(ct);
                    await RefreshRequestsAsync(ct);
                }
                catch (Exception ex) when (!ct.IsCancellationRequested)
                {
                    Log.LogWarning(ex, "A broadcast poll failed; the next one runs in {Interval}.", PollInterval);
                }
            }
            while (await timer.WaitForNextTickAsync(ct));
        }
        catch (Exception) when (ct.IsCancellationRequested)
        {
            // The page has gone.
        }
    }

    private async Task TickClockAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            do
            {
                await InvokeAsync(StateHasChanged);
            }
            while (await timer.WaitForNextTickAsync(ct));
        }
        catch (Exception) when (ct.IsCancellationRequested)
        {
            // The page has gone.
        }
    }

    /// <summary>A token that also fires after <see cref="RequestTimeout"/>, so one hung read cannot hold a loop for long.</summary>
    private CancellationTokenSource Bounded(CancellationToken ct)
    {
        var bounded = CancellationTokenSource.CreateLinkedTokenSource(ct);
        bounded.CancelAfter(RequestTimeout);
        return bounded;
    }

    private async Task RefreshNowAsync(CancellationToken ct)
    {
        try
        {
            using var bounded = Bounded(ct);
            var now = await Broadcast.GetNowAsync(bounded.Token);
            await InvokeAsync(() => ApplyNow(now));
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            // The last view stays on screen with the link line until a poll succeeds.
            Log.LogWarning(ex, "Reading /api/broadcast/now failed.");
            await InvokeAsync(() =>
            {
                _linkError = ex.Message;
                StateHasChanged();
            });
        }
    }

    /// <summary>Runs on the render thread. A new running game is followed; the same one is left alone.</summary>
    private void ApplyNow(LiveNowNext now)
    {
        _now = now;
        _linkError = null;
        if (now.Current is { GameId: { } gameId } current && gameId != _live?.GameId)
        {
            Follow(gameId, current.White, current.Black, current.PlannedStart);
        }

        Reconcile();
        StateHasChanged();
    }

    /// <summary>
    /// Follows a game of the request queue that is not in the schedule, so the status line says who asked for it.
    /// </summary>
    private void FollowRequest(GameRequestDto playing, Guid gameId) =>
        Follow(gameId, new PlayerSpec("llm", playing.White), new PlayerSpec("llm", playing.Black), playing.ReceivedAt);

    private void Follow(Guid gameId, PlayerSpec white, PlayerSpec black, DateTimeOffset startedAt)
    {
        // Cancel only: the previous game's readers may still hold its token.
        _follow?.Cancel();
        _follow = new CancellationTokenSource();

        // The placeholder summary carries the players from the slot; the load replaces it with the server's.
        _live = new LiveGame(new GameSummaryDto(gameId, null, white, black, true, "running", "*", null, 0, startedAt, null));
        _ = Observe(FollowAsync(gameId, _follow.Token), "following the game");
    }

    /// <summary>
    /// Opens the stream first, then loads the game (03 §5.1), as the live game page does. When the game is over the
    /// leaderboard is read again, so the ratings include the game that just ended.
    /// </summary>
    private async Task FollowAsync(Guid gameId, CancellationToken ct)
    {
        try
        {
            var reading = ReadStreamAsync(gameId, ct);
            await LoadAsync(gameId, ct);
            await reading;
            await RefreshLeaderboardAsync(ct);
        }
        catch (Exception) when (ct.IsCancellationRequested)
        {
            // The broadcast moved on to another game, or the page has gone.
        }
    }

    private async Task ReadStreamAsync(Guid gameId, CancellationToken ct)
    {
        var delay = ReconnectDelay;
        while (true)
        {
            try
            {
                await foreach (var message in Events.StreamAsync(gameId, ct))
                {
                    delay = ReconnectDelay;

                    // ComponentBase.InvokeAsync has no Func<T> overload, so the result comes back through a local.
                    var result = ApplyResult.Unknown;
                    await InvokeAsync(() => result = ApplyEvent(gameId, message, ct));
                    if (result == ApplyResult.Gap)
                    {
                        await LoadAsync(gameId, ct);
                    }

                    if (message.Type == "GameFinished")
                    {
                        return;
                    }
                }
            }
            catch (Exception) when (!ct.IsCancellationRequested)
            {
                // A stream that cannot be read is retried below, the same as one that closed early. A timeout of the
                // HttpClient is a TaskCanceledException, which is not a reason to give the game up.
            }

            // The stream closed before the game finished, or could not be opened: load the game as it is, then reconnect.
            await LoadAsync(gameId, ct);
            var over = false;
            await InvokeAsync(() => over = IsOver(gameId));
            if (over)
            {
                return;
            }

            await Task.Delay(delay, ct);
            delay = TimeSpan.FromTicks(Math.Min(delay.Ticks * 2, MaxReconnectDelay.Ticks));
        }
    }

    private async Task LoadAsync(Guid gameId, CancellationToken ct)
    {
        try
        {
            using var bounded = Bounded(ct);
            var detail = await Api.GetGameAsync(gameId, bounded.Token);
            await InvokeAsync(() =>
            {
                if (!ct.IsCancellationRequested && _live is { } live && live.GameId == gameId)
                {
                    live.Load(detail);
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            // The next stream event or the next reconnect loads the game again.
            Log.LogDebug(ex, "Loading game {GameId} failed.", gameId);
        }
    }

    /// <summary>Runs on the render thread. Events for a game the page has left are dropped.</summary>
    private ApplyResult ApplyEvent(Guid gameId, GameEventMessage message, CancellationToken ct)
    {
        if (ct.IsCancellationRequested || _live is not { } live || live.GameId != gameId)
        {
            return ApplyResult.Unknown;
        }

        var result = live.Apply(message);
        StateHasChanged();
        return result;
    }

    private bool IsOver(Guid gameId) => _live is not { } live || live.GameId != gameId || live.IsFinished;

    private async Task RefreshLeaderboardAsync(CancellationToken ct)
    {
        try
        {
            using var bounded = Bounded(ct);
            var board = await Api.GetLeaderboardAsync(bounded.Token);
            await InvokeAsync(() =>
            {
                _leaderboard = board;
                StateHasChanged();
            });
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            // The last table stays on screen; the next finished game reads it again.
            Log.LogDebug(ex, "Reading the leaderboard failed.");
        }
    }

    /// <summary>Reads the pace of the running schedule, which the replays use.</summary>
    private async Task RefreshScheduleAsync(CancellationToken ct)
    {
        try
        {
            using var bounded = Bounded(ct);
            var schedules = await Broadcast.GetSchedulesAsync(bounded.Token);
            var active = schedules.FirstOrDefault(schedule => schedule.Status is "running" or "paused");
            await InvokeAsync(() =>
            {
                _pacing = active?.Pacing;
                StateHasChanged();
            });
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            // The replays keep the pace they had, or the default.
            Log.LogDebug(ex, "Reading the schedules failed.");
        }
    }

    /// <summary>
    /// Reads the request queue on every poll. An API without requests answers an error, which leaves the queue null, so
    /// nothing is shown and nothing is logged as a failure of the stage.
    /// </summary>
    private async Task RefreshRequestsAsync(CancellationToken ct)
    {
        var queue = await TryReadAsync(token => Api.GetRequestQueueAsync(token), ct);
        await InvokeAsync(() => ApplyRequests(queue));
    }

    private async Task<T?> TryReadAsync<T>(Func<CancellationToken, Task<T>> read, CancellationToken ct) where T : class
    {
        try
        {
            using var bounded = Bounded(ct);
            return await read(bounded.Token);
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            Log.LogDebug(ex, "A read of the request queue failed.");
            return null;
        }
    }

    /// <summary>Runs on the render thread. A running request is followed, as a schedule game is, unless a schedule game is on.</summary>
    private void ApplyRequests(RequestQueueDto? queue)
    {
        _queue = queue;
        _queueKnown = true;
        if (queue?.Playing is { GameId: { } gameId } playing && _now?.Current is null && gameId != _live?.GameId)
        {
            FollowRequest(playing, gameId);
        }

        Reconcile();
        StateHasChanged();
    }

    /// <summary>
    /// Starts or stops the replay loop from the state the page has: a replay runs only while the broadcast is running, no
    /// game is scheduled after this one, and nothing is queued or playing (03 §15.6). Before a scheduled game the
    /// intermission card with its countdown is shown instead, so a replay never covers it. Runs on the render thread.
    /// </summary>
    private void Reconcile()
    {
        var replayWanted = _queueKnown
            && _now is { Status: "running", Current: null, Next: { Count: 0 } }
            && !LiveRequestView.HasWaiting(_queue);
        if (!replayWanted)
        {
            StopReplays();
        }
        else if (_replays is null)
        {
            var replays = new CancellationTokenSource();
            _replays = replays;
            _ = Observe(PlayReplaysAsync(replays), "the replays");
        }
    }

    private void StopReplays()
    {
        if (_replays is null)
        {
            return;
        }

        _replays.Cancel();
        _replays = null;
        _replaying = false;
    }

    /// <summary>
    /// Plays stored games one after another at the broadcast's move pace, holding each final position for
    /// <see cref="ReplayHold"/>. The stored games come from the finished list, the best-rated pick first. With none to play
    /// the loop ends and the intermission shows.
    /// </summary>
    private async Task PlayReplaysAsync(CancellationTokenSource replays)
    {
        var ct = replays.Token;
        try
        {
            // The pace comes from the schedule: read it before the first replay.
            await RefreshScheduleAsync(ct);
            while (!ct.IsCancellationRequested)
            {
                var recent = await Api.GetGamesAsync(1, ReplayPicker.Pool, null, "finished", ct);
                var pick = ReplayPicker.Pick(recent.Items, _leaderboard, _lastReplay);
                if (pick is null)
                {
                    return;
                }

                var game = await Api.GetGameAsync(pick.Id, ct);
                _lastReplay = pick.Id;
                await InvokeAsync(() => ShowReplay(replays, game, 0));
                for (var ply = 1; ply <= game.Moves.Count; ply++)
                {
                    await Task.Delay(MovePace, ct);
                    await InvokeAsync(() => ShowReplay(replays, game, ply));
                }

                await Task.Delay(ReplayHold, ct);
            }
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            // A replay is optional: without one the broadcast shows its intermission card. A timeout of the HttpClient is
            // a TaskCanceledException and ends the loop the same way.
            Log.LogDebug(ex, "The replays stopped.");
        }
        catch (Exception) when (ct.IsCancellationRequested)
        {
            // The queue or the schedule moved on, or the page has gone.
        }
        finally
        {
            await InvokeAsync(() =>
            {
                if (ReferenceEquals(_replays, replays))
                {
                    _replays = null;
                    _replaying = false;
                    StateHasChanged();
                }
            });
        }
    }

    /// <summary>Runs on the render thread. Shows the stored game after <paramref name="ply"/> plies, unless its loop has been stopped.</summary>
    private void ShowReplay(CancellationTokenSource replays, GameDetailDto game, int ply)
    {
        if (replays.IsCancellationRequested || !ReferenceEquals(_replays, replays))
        {
            return;
        }

        _replaying = true;
        _live = new LiveGame(game.Summary);
        _live.Load(ReplayPicker.UpTo(game, ply));
        StateHasChanged();
    }

    private TimeSpan MovePace => TimeSpan.FromMilliseconds(_pacing?.MoveDelayMs ?? DefaultMoveDelayMs);

    /// <summary>The name of a side on the board, with its reasoning effort after a dot when the model has one.</summary>
    private string SideLabel(PlayerSpec? player)
    {
        if (player is null)
        {
            return "—";
        }

        var id = PlayerId.Parse(player.ModelId);
        var name = ModelName(id.Model);
        return id.Effort is null ? name : $"{name} · {id.Effort}";
    }

    private string ModelName(string modelId) => _models.FirstOrDefault(model => model.Id == modelId)?.DisplayName ?? modelId;

    private string ColourOf(string? modelId) =>
        modelId is null ? "transparent" : LiveBroadcastView.Colour(modelId, _modelIds, IsLight);

    public void Dispose()
    {
        // Cancel only: disposing a source a reader may still hold a token from can throw in those readers.
        _lifetime.Cancel();
        _follow?.Cancel();
        _replays?.Cancel();
    }
}
