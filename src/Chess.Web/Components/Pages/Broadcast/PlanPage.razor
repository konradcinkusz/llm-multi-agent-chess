@page "/broadcast/plan"
@using Chess.Web.Api
@using Chess.Web.Components.Pages.Tournaments
@implements IDisposable
@inject ArenaApiClient Api
@inject IHttpClientFactory HttpClients

<PageTitle>Broadcast plan · LLM Chess Arena</PageTitle>

<div class="page-header">
    <h1>Broadcast plan</h1>
    <p class="page-lede">Add the games one by one, White against Black. They play in this order as soon as you press Start.</p>
</div>

@* Every action reports here, whichever section it came from. *@
@if (_actionError is not null)
{
    <p class="status-error" role="alert">@_actionError</p>
}

<div class="stack-lg">
<section class="plan-section" aria-labelledby="plan-games-heading">
    <h2 id="plan-games-heading">1. Games</h2>

    <div class="card stack">

    @if (_models is null && _modelsError is null)
    {
        <p>Loading models…</p>
    }
    else if (_modelsError is not null)
    {
        <p class="status-error" role="alert">Could not load the models: @_modelsError</p>
    }
    else
    {
        <div class="field-row">
            <label class="field">
                Name
                <input data-testid="plan-name" type="text" maxlength="120" @bind="_name" />
            </label>
            <label class="field">
                Move delay (ms)
                <input data-testid="plan-move-delay" type="number" min="0" step="500" @bind="_moveDelayMs" />
            </label>
            <label class="field">
                Game gap (min)
                <input data-testid="plan-game-gap" type="number" min="0" @bind="_gameGapMinutes" />
            </label>
        </div>

        @if (_styles.Count > 1)
        {
            <fieldset class="plan-styles" data-testid="plan-styles">
                <legend>Prompt styles offered</legend>
                <div class="chips">
                    @foreach (var style in _styles)
                    {
                        <label class="chip plan-style">
                            <input data-testid="plan-style-@style.Id" type="checkbox" checked="@_selectedStyles.Contains(style.Id)"
                                   @onchange="e => ToggleStyle(style.Id, e.Value)" />
                            @style.DisplayName
                        </label>
                    }
                </div>
            </fieldset>
        }

        @if (_stylesNotice is { } notice)
        {
            <p class="field-hint" data-testid="styles-notice">@notice</p>
        }

        <div class="cluster plan-add">
            <label>
                White
                <select data-testid="add-white" value="@_pickWhite" disabled="@_busy"
                        @onchange="e => _pickWhite = e.Value?.ToString()">
                    <option value="">Choose a model</option>
                    @foreach (var player in Players)
                    {
                        <option value="@player">@NameOf(player)</option>
                    }
                </select>
            </label>
            <label>
                Black
                <select data-testid="add-black" value="@_pickBlack" disabled="@_busy"
                        @onchange="e => _pickBlack = e.Value?.ToString()">
                    <option value="">Choose a model</option>
                    @foreach (var player in Players)
                    {
                        <option value="@player">@NameOf(player)</option>
                    }
                </select>
            </label>
            <button data-testid="add-game" type="button" class="btn" @onclick="AddGame" disabled="@(!CanAddGame)">Add game</button>
        </div>
        @if (_addError is not null)
        {
            <p class="plan-problem">@_addError</p>
        }

        @if (_slots.Count == 0)
        {
            <p class="muted" data-testid="plan-empty">No games yet. Pick White and Black, then Add game.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="plan-slots">
                    <thead>
                        <tr>
                            <th class="num">#</th>
                            <th>White</th>
                            <th>Black</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _slots.Count; i++)
                        {
                            var index = i;
                            var slot = _slots[i];
                            <tr data-testid="plan-slot">
                                <td class="num">@(index + 1)</td>
                                <td data-testid="slot-white">@NameOf(slot.White.ModelId)</td>
                                <td data-testid="slot-black">@NameOf(slot.Black.ModelId)</td>
                                <td class="plan-row-actions">
                                    <button data-testid="slot-up" type="button" class="btn-sm" disabled="@(_busy || index == 0)"
                                            @onclick="() => Reorder(index, -1)">Up</button>
                                    <button data-testid="slot-down" type="button" class="btn-sm" disabled="@(_busy || index == _slots.Count - 1)"
                                            @onclick="() => Reorder(index, 1)">Down</button>
                                    <button data-testid="slot-delete" type="button" class="btn-sm btn-danger" disabled="@_busy"
                                            @onclick="() => Delete(index)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            var models = _slots.SelectMany(slot => new[] { slot.White.ModelId, slot.Black.ModelId }).Distinct().ToList();
            <div class="callout callout-info plan-estimate" data-testid="plan-estimate" aria-live="polite">
                <h3>Estimated cost of the broadcast</h3>
                <p class="plan-total" data-testid="plan-total">
                    Estimated total for @_slots.Count game@(_slots.Count == 1 ? "" : "s"):
                    @TournamentFormat.Requests(Known(models.Select(RequestsFor))) premium requests ·
                    @TournamentFormat.Credits(Known(models.Select(model => CostOf(model)?.AiCredits))) AI credits ·
                    @TournamentFormat.Usd(Known(models.Select(model => CostOf(model)?.Usd)))
                    @if (UnknownCount(models) > 0)
                    {
                        <span>, plus @UnknownCount(models) model@(UnknownCount(models) == 1 ? "" : "s") billed by token, counted in AI credits</span>
                    }
                </p>
                <p class="muted">
                    Assumes @AssumedPlies plies a game and @(AssumedMoveLatencyMs / 1000) s a move (ADR-011). An upper bound, not a bill.
                    AI credits and USD use the API's rate and the tokens of past moves.
                </p>
                <div class="table-wrap">
                    <table class="table-compact">
                        <thead>
                            <tr><th>Model</th><th>Price</th><th class="num">Games</th><th class="num">Premium requests</th><th class="num">AI credits</th><th class="num">USD</th><th>Tokens per move</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var model in models)
                            {
                                var cost = CostOf(model);
                                <tr>
                                    <td>@NameOf(model)</td>
                                    <td>@TournamentFormat.Price(Find(model)?.Pricing)</td>
                                    <td class="num">@_slots.Count(slot => slot.White.ModelId == model || slot.Black.ModelId == model)</td>
                                    <td class="num">@TournamentFormat.Requests(RequestsFor(model))</td>
                                    <td class="num">@TournamentFormat.Credits(cost?.AiCredits)</td>
                                    <td class="num">@TournamentFormat.Usd(cost?.Usd)</td>
                                    <td>@TournamentFormat.Basis(cost?.Basis, cost?.SampleMoves)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @foreach (var problem in Problems)
        {
            <p class="plan-problem error-text">@problem</p>
        }

        <div class="cluster">
            <button data-testid="plan-start-now" type="button" class="btn-primary" @onclick="StartAsync" disabled="@(!CanStart)">Start</button>
            @if (ChannelBusy(Guid.Empty))
            {
                <span class="muted">Another broadcast is playing. Stop it to start this one.</span>
            }
        </div>
    }
    </div>
</section>

<section class="plan-section" aria-labelledby="plan-schedules-heading">
    <h2 id="plan-schedules-heading">2. Broadcasts</h2>

    @if (_scheduleError is not null)
    {
        <p class="status-error" role="alert">Could not load the schedules: @_scheduleError</p>
    }

    @if (_schedules is null)
    {
        <p>Loading schedules…</p>
    }
    else if (_schedules.Count == 0)
    {
        <p>No broadcasts yet. Add games above and press Start.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="plan-schedules">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Window (UTC)</th>
                        <th>Games</th>
                        <th>Estimate (AI credits, USD)</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var schedule in _schedules)
                    {
                        <tr data-testid="schedule-row">
                            <td>@schedule.Name</td>
                            <td><span class="badge @ScheduleBadge(schedule.Status)">@PlanFormat.Status(schedule.Status)</span></td>
                            <td>@PlanFormat.Utc(schedule.StartsAt) to @PlanFormat.Utc(schedule.EndsAt)</td>
                            <td class="num">@schedule.SlotsFinished of @schedule.SlotsTotal</td>
                            <td>
                                @string.Join(", ", schedule.EstimatedPremiumRequests.Select(EstimateText))
                            </td>
                            <td class="plan-row-actions">
                                @if (schedule.Status is ScheduleStatuses.Draft or ScheduleStatuses.Scheduled)
                                {
                                    <button data-testid="schedule-start" type="button" class="btn-sm btn-primary"
                                            disabled="@(_busy || ChannelBusy(schedule.Id))"
                                            @onclick="() => CommandAsync(schedule.Id, StartFailure, _broadcast.StartAsync)">Start</button>
                                }
                                @if (schedule.Status == ScheduleStatuses.Running)
                                {
                                    <button data-testid="schedule-pause" type="button" class="btn-sm" disabled="@_busy"
                                            @onclick="() => CommandAsync(schedule.Id, PauseFailure, _broadcast.PauseAsync)">Pause</button>
                                }
                                @if (schedule.Status == ScheduleStatuses.Paused)
                                {
                                    <button data-testid="schedule-resume" type="button" class="btn-sm" disabled="@(_busy || ChannelBusy(schedule.Id))"
                                            @onclick="() => CommandAsync(schedule.Id, ResumeFailure, _broadcast.ResumeAsync)">Resume</button>
                                }
                                @if (schedule.Status is ScheduleStatuses.Scheduled or ScheduleStatuses.Running or ScheduleStatuses.Paused)
                                {
                                    <button data-testid="schedule-stop" type="button" class="btn-sm btn-danger" disabled="@_busy"
                                            @onclick="() => CommandAsync(schedule.Id, StopFailure, _broadcast.StopAsync)">Stop</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
</div>

@code {
    /// <summary>
    /// The pace the estimate and the games' windows assume (ADR-011): 80 plies at 40 s a move. The page does not ask
    /// for these, so it states them beside the estimate.
    /// </summary>
    private const double AssumedPlies = 80;
    private const double AssumedMoveLatencyMs = 40_000;
    private const int DefaultMoveDelayMs = 4000;
    private const int DefaultGameGapMinutes = 30;
    private const int Seed = 1;

    /// <summary>The badge variant (07 §4) for a schedule status: running is accented, paused a warning, finished a success.</summary>
    private static string ScheduleBadge(string status) => status switch
    {
        ScheduleStatuses.Running => "badge-accent",
        ScheduleStatuses.Paused => "badge-warning",
        ScheduleStatuses.Finished => "badge-success",
        _ => "badge-neutral",
    };

    private const string StartFailure = "Could not start:";
    private const string PauseFailure = "Could not pause:";
    private const string ResumeFailure = "Could not resume:";
    private const string StopFailure = "Could not stop:";

    private readonly CancellationTokenSource _cts = new();
    private BroadcastApiClient _broadcast = null!;

    private IReadOnlyList<ModelDto>? _models;
    private CostInputsDto? _costs;
    private string? _modelsError;
    private IReadOnlyList<ModelDto> _choices = [];
    private IReadOnlyList<PromptStyleDto> _styles = [PromptStyleChoices.Classic];
    private string? _stylesNotice;
    private readonly HashSet<string> _selectedStyles = [PlayerId.DefaultStyle];

    private string _name = "LLM Chess broadcast";
    private int _moveDelayMs = DefaultMoveDelayMs;
    private int _gameGapMinutes = DefaultGameGapMinutes;

    // The games in play order. Their times are filled in when Start is pressed, so only the players matter here.
    private readonly List<SlotEdit> _slots = [];

    private IReadOnlyList<ScheduleDto>? _schedules;
    private string? _scheduleError;
    private string? _actionError;
    private bool _busy;

    private string? _pickWhite;
    private string? _pickBlack;
    private string? _addError;

    protected override async Task OnInitializedAsync()
    {
        _broadcast = new BroadcastApiClient(HttpClients.CreateClient(BroadcastApiClient.ClientName));
        try
        {
            _models = await Api.GetModelsAsync(_cts.Token);
            _choices = _models.Where(model => model.Enabled).ToArray();
        }
        catch (HttpRequestException ex)
        {
            _modelsError = ex.Message;
        }

        var styles = await PromptStyleChoices.LoadAsync(Api, _cts.Token);
        _styles = styles.Styles;
        _stylesNotice = styles.Notice;

        await LoadCostInputsAsync();
        await ReloadSchedulesAsync();
    }

    /// <summary>The API's rate and tokens. Null when they could not be loaded: the estimate then shows premium requests only.</summary>
    private async Task LoadCostInputsAsync()
    {
        try
        {
            _costs = await Api.GetCostInputsAsync(_cts.Token);
        }
        catch (HttpRequestException)
        {
            _costs = null;
        }
    }

    private IReadOnlyList<string> SelectedStyles =>
        _styles.Where(style => _selectedStyles.Contains(style.Id)).Select(style => style.Id).ToArray();

    /// <summary>Every enabled model, with each reasoning effort it offers, in every selected style: the players to pick from.</summary>
    private IReadOnlyList<string> Players =>
    [
        .. _choices.SelectMany(model => EffortsOf(model).SelectMany(effort =>
            SelectedStyles.Select(style => PromptStyleChoices.Player(model.Id, effort, style))))
    ];

    private static IEnumerable<string?> EffortsOf(ModelDto model) =>
        model.ReasoningEfforts is { Count: > 0 } efforts ? new string?[] { null }.Concat(efforts) : [null];

    private IReadOnlyList<string> Problems
    {
        get
        {
            var problems = new List<string>();
            if (string.IsNullOrWhiteSpace(_name))
            {
                problems.Add("Give the broadcast a name.");
            }

            if (_moveDelayMs < 0 || _gameGapMinutes < 0)
            {
                problems.Add("Pacing values must not be negative.");
            }
            else if (_slots.Count > 0 && Hours(Window(DateTimeOffset.UtcNow)) > PlanPlanner.MaxDurationHours)
            {
                problems.Add($"The games would run past {PlanPlanner.MaxDurationHours} hours. Remove a game or shorten the pacing.");
            }

            return problems;
        }
    }

    private bool CanStart => !_busy && _slots.Count > 0 && Problems.Count == 0 && !ChannelBusy(Guid.Empty);

    private bool CanAddGame => !_busy && _pickWhite is not null && _pickBlack is not null
        && _pickWhite != _pickBlack && Players.Contains(_pickWhite) && Players.Contains(_pickBlack);

    private TimeSpan GameLength => TimeSpan.FromMilliseconds(AssumedPlies * (AssumedMoveLatencyMs + _moveDelayMs));

    /// <summary>True while another schedule is running or paused: the API runs one channel at a time.</summary>
    private bool ChannelBusy(Guid scheduleId) =>
        _schedules?.Any(schedule => schedule.Id != scheduleId
            && schedule.Status is ScheduleStatuses.Running or ScheduleStatuses.Paused) == true;

    private int UnknownCount(IEnumerable<string> models) => models.Count(model => RequestsFor(model) is null);

    private IReadOnlyDictionary<string, double?> Multipliers => (_models ?? Array.Empty<ModelDto>())
        .ToDictionary(model => model.Id, model => model.PremiumMultiplier, StringComparer.Ordinal);

    private double? RequestsFor(string model) => PlanPlanner.Requests(model, _slots, AssumedPlies, Multipliers);

    /// <summary>A model's estimate over the games on screen: the same moves as the planner's (games × plies ÷ 2 a side).</summary>
    private CostPreview.Estimate? CostOf(string model)
    {
        if (_costs is not { } costs || Find(model) is not { } entry)
        {
            return null;
        }

        var games = _slots.Count(slot => slot.White.ModelId == model || slot.Black.ModelId == model);
        return CostPreview.For(entry, costs, games * (AssumedPlies / 2));
    }

    /// <summary>The sum of the known figures, or null when none is known.</summary>
    private static double? Known(IEnumerable<double?> values)
    {
        var known = values.OfType<double>().ToList();
        return known.Count == 0 ? null : known.Sum();
    }

    /// <summary>The model a player plays as, with the player's id, so its prices are looked up under that player.</summary>
    private ModelDto? Find(string playerId) => PromptStyleChoices.Find(_models, playerId);

    /// <summary>The player's model, then its style when it is not classic, then its reasoning effort.</summary>
    private string NameOf(string playerId)
    {
        var label = PromptStyleChoices.Label(playerId, _models, _styles);
        return PlayerId.Parse(playerId).Effort is { } effort ? $"{label} · {effort}" : label;
    }

    /// <summary>A schedule's estimate for one model on its row: the premium requests when it has a multiplier, then the credits and USD.</summary>
    private string EstimateText(ModelPremiumEstimateDto estimate)
    {
        var premium = estimate.EstimatedPremiumRequests is { } requests
            ? $"{TournamentFormat.Requests(requests)} premium requests · "
            : "";
        var cost = estimate.EstimatedAiCredits is { } credits
            ? $"{TournamentFormat.Credits(credits)} ({TournamentFormat.Usd(estimate.EstimatedUsd)})"
            : "price unknown";
        return $"{NameOf(estimate.ModelId)}: {premium}{cost}";
    }

    private void ToggleStyle(string styleId, object? selected)
    {
        if (selected is true)
        {
            _selectedStyles.Add(styleId);
        }
        else
        {
            _selectedStyles.Remove(styleId);
        }
    }

    private void AddGame()
    {
        _addError = null;
        if (!CanAddGame)
        {
            return;
        }

        _slots.Add(new SlotEdit(new PlayerSpec("llm", _pickWhite!), new PlayerSpec("llm", _pickBlack!),
            DateTimeOffset.UnixEpoch, DateTimeOffset.UnixEpoch));
        _actionError = null;
    }

    /// <summary>Swaps game <paramref name="index"/> with its neighbour.</summary>
    private void Reorder(int index, int delta) => (_slots[index], _slots[index + delta]) = (_slots[index + delta], _slots[index]);

    private void Delete(int index) => _slots.RemoveAt(index);

    /// <summary>The games laid end to end from <paramref name="start"/>, each after the previous one plus the gap.</summary>
    private List<SlotEdit> Window(DateTimeOffset start)
    {
        var timed = new List<SlotEdit>();
        var next = start;
        foreach (var slot in _slots)
        {
            var end = next + GameLength;
            timed.Add(slot with { PlannedStart = next, PlannedEnd = end });
            next = end + TimeSpan.FromMinutes(_gameGapMinutes);
        }

        return timed;
    }

    private static int Hours(IReadOnlyList<SlotEdit> timed) =>
        timed.Count == 0 ? 1 : Math.Max(1, (int)Math.Ceiling((timed[^1].PlannedEnd - timed[0].PlannedStart).TotalHours));

    /// <summary>
    /// Saves the games as a schedule that begins now, then starts it. The schedule window is the span of the games, so
    /// the API accepts every game. On success the list is emptied for the next broadcast.
    /// </summary>
    private Task StartAsync()
    {
        if (!CanStart)
        {
            return Task.CompletedTask;
        }

        return RunAsync(StartFailure, async ct =>
        {
            var timed = Window(DateTimeOffset.UtcNow);
            var players = timed.SelectMany(slot => new[] { slot.White.ModelId, slot.Black.ModelId }).Distinct().ToList();
            var request = new PlanRequest(_name.Trim(), players, timed[0].PlannedStart, Hours(timed),
                new PacingProfile(_moveDelayMs, _gameGapMinutes * 60), Seed, AssumedPlies, AssumedMoveLatencyMs);

            var saved = await _broadcast.PlanAsync(request, ct);
            await _broadcast.ReplaceSlotsAsync(saved.Schedule.Id, timed, ct);
            await _broadcast.StartAsync(saved.Schedule.Id, ct);
            _slots.Clear();
        });
    }

    /// <summary>Runs a schedule command from the list of broadcasts.</summary>
    private Task CommandAsync(Guid scheduleId, string failure, Func<Guid, CancellationToken, Task<ScheduleDetailDto>> command)
    {
        if (_busy)
        {
            return Task.CompletedTask;
        }

        return RunAsync(failure, async ct => await command(scheduleId, ct));
    }

    /// <summary>
    /// Runs one API action with the page marked busy, shows the API's reason when it is refused, and reloads the
    /// schedules either way so the list shows what the API now holds.
    /// </summary>
    private async Task RunAsync(string failure, Func<CancellationToken, Task> work)
    {
        _busy = true;
        _actionError = null;
        StateHasChanged();
        try
        {
            await work(_cts.Token);
        }
        catch (BroadcastApiException ex)
        {
            _actionError = $"{failure} {ex.Message}";
        }
        catch (HttpRequestException ex)
        {
            _actionError = $"{failure} {ex.Message}";
        }
        finally
        {
            _busy = false;
        }

        await ReloadSchedulesAsync();
    }

    private async Task ReloadSchedulesAsync()
    {
        try
        {
            _schedules = await _broadcast.GetSchedulesAsync(_cts.Token);
            _scheduleError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or BroadcastApiException)
        {
            _scheduleError = ex.Message;
        }
    }

    public void Dispose() => _cts.Cancel();
}
