@page "/tournaments"
@using Chess.Web.Api
@implements IDisposable
@inject ArenaApiClient Api

<PageTitle>Tournaments · LLM Chess Arena</PageTitle>

<div class="page-header">
    <h1>Tournaments</h1>
    <p class="page-lede">Every selected model plays every other one, the number of games per pair you choose.</p>
</div>

<div class="stack-lg">
<section class="tournament-section" aria-labelledby="new-tournament-heading">
    <h2 id="new-tournament-heading">New round robin</h2>

    @if (_models is null && _modelsError is null)
    {
        <p>Loading models…</p>
    }
    else if (_modelsError is not null)
    {
        <p class="status-error" role="alert">Could not load the models: @_modelsError</p>
    }
    else
    {
        <div class="card stack">
            <div class="field-row">
                <label class="field">
                    Name
                    <input id="tournament-name" type="text" maxlength="120" @bind="_name" @bind:event="oninput" />
                </label>

                <label class="field">
                    Games per pair
                    <select id="games-per-pair" @bind="_gamesPerPair">
                        @foreach (var games in GamesPerPairChoices)
                        {
                            <option value="@games">@games</option>
                        }
                    </select>
                </label>

                <label class="field">
                    Max concurrency
                    <select id="max-concurrency" @bind="_maxConcurrency">
                        @for (var limit = 1; limit <= TournamentFormRules.MaxConcurrencyLimit; limit++)
                        {
                            <option value="@limit">@limit</option>
                        }
                    </select>
                </label>
            </div>

            <fieldset class="tournament-models">
                <legend>Models</legend>
                <div class="chips">
                    @foreach (var model in _choices)
                    {
                        <label class="chip">
                            <input id="model-@model.Id" type="checkbox" checked="@_selected.Contains(model.Id)"
                                   @onchange="e => Toggle(model.Id, e.Value)" />
                            @model.DisplayName
                            <span class="muted">@TournamentFormat.Cost(model)</span>
                        </label>
                    }
                </div>
            </fieldset>

            @if (SelectedModels.Count >= 2)
            {
                var pairs = SelectedModels.Count * (SelectedModels.Count - 1) / 2;
                var gameCount = pairs * _gamesPerPair;
                var estimates = PremiumEstimate.For(_models!, SelectedModels, _gamesPerPair);
                var unknown = estimates.Count(estimate => estimate.Requests is null);
                var gamesPerModel = (SelectedModels.Count - 1) * _gamesPerPair;

                <div class="callout callout-info tournament-estimate" aria-live="polite">
                    <h3>Estimated cost</h3>
                    <p>
                        @gameCount @(gameCount == 1 ? "game" : "games") in @pairs @(pairs == 1 ? "pair" : "pairs").
                        Each model is estimated at @PremiumEstimate.RequestsPerGame requests a game (its moves on one side, 03 §9.1),
                        so the premium figure is an upper bound, not a bill. AI credits and USD use the API's rate and the
                        tokens of past moves, as the saved tournament will.
                    </p>
                    <div class="table-wrap">
                        <table class="table-compact">
                            <thead>
                                <tr><th>Model</th><th>Price</th><th class="num">Premium requests</th><th class="num">AI credits</th><th class="num">USD</th><th>Tokens per move</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var estimate in estimates)
                                {
                                    var cost = CostOf(estimate.ModelId, gamesPerModel);
                                    <tr>
                                        <td>@estimate.ModelId</td>
                                        <td>@TournamentFormat.Price(Find(estimate.ModelId)?.Pricing)</td>
                                        <td class="num">@TournamentFormat.Requests(estimate.Requests)</td>
                                        <td class="num">@TournamentFormat.Credits(cost?.AiCredits)</td>
                                        <td class="num">@TournamentFormat.Usd(cost?.Usd)</td>
                                        <td>@TournamentFormat.Basis(cost?.Basis, cost?.SampleMoves)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Known total: @TournamentFormat.Requests(PremiumEstimate.Known(estimates))
                        @if (unknown > 0)
                        {
                            <span>, plus @unknown model@(unknown == 1 ? "" : "s") with an unknown multiplier</span>
                        }
                    </p>
                    <p>
                        Known AI credits: @TournamentFormat.Credits(KnownCredits(SelectedModels, gamesPerModel)),
                        USD: @TournamentFormat.Usd(KnownUsd(SelectedModels, gamesPerModel)).
                    </p>
                </div>
            }

            @foreach (var problem in Problems)
            {
                <p class="tournament-problem error-text">@problem</p>
            }

            <div class="cluster">
                <button id="start-tournament" type="button" class="btn-primary" @onclick="StartAsync" disabled="@(Problems.Count > 0 || _submitting)">
                    Start tournament
                </button>
            </div>

            @if (_createError is not null)
            {
                <p class="status-error" role="alert">@_createError</p>
            }

            @if (_created is { } created)
            {
                <div class="callout tournament-created" role="status">
                    <p>
                        Started <strong>@created.Tournament.Name</strong> with @created.Tournament.GamesTotal games.
                        <a href="/tournaments/@created.Tournament.Id">Open the tournament</a>
                    </p>
                    <p>Estimated by the API, per model: premium requests, then AI credits and USD from the models' prices and their past moves.</p>
                    <ul>
                        @foreach (var estimate in created.EstimatedPremiumRequests)
                        {
                            <li>
                                @estimate.ModelId: @TournamentFormat.Requests(estimate.EstimatedPremiumRequests)
                                @if (estimate.EstimatedAiCredits is { } credits)
                                {
                                    <span>· @TournamentFormat.Credits(credits) · @TournamentFormat.Usd(estimate.EstimatedUsd) (@TournamentFormat.Basis(estimate.TokenBasis, estimate.SampleMoves))</span>
                                }
                                else
                                {
                                    <span>· @TournamentFormat.Basis(estimate.TokenBasis, estimate.SampleMoves)</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</section>

<section class="tournament-section" aria-labelledby="tournament-list-heading">
    <h2 id="tournament-list-heading">All tournaments</h2>

    @if (_listError is not null)
    {
        <p class="status-error" role="alert">Could not load the tournaments: @_listError</p>
    }

    @if (_tournaments is null)
    {
        <p>Loading tournaments…</p>
    }
    else if (_tournaments.Count == 0)
    {
        <p>No tournaments yet. Create one above.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="tournament-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Models</th>
                        <th class="num">Games per pair</th>
                        <th>Status</th>
                        <th>Progress</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tournament in _tournaments)
                    {
                        <tr>
                            <td><a href="/tournaments/@tournament.Id">@tournament.Name</a></td>
                            <td>@string.Join(", ", tournament.Models)</td>
                            <td class="num">@tournament.GamesPerPair</td>
                            <td><span class="badge @TournamentFormat.StatusBadge(tournament.Status)">@TournamentFormat.Status(tournament.Status)</span></td>
                            <td><TournamentProgress Finished="tournament.GamesFinished" Total="tournament.GamesTotal" /></td>
                            <td>
                                @if (TournamentFormat.IsRunning(tournament.Status))
                                {
                                    <CancelTournament TournamentId="tournament.Id" Cancelled="ReloadListAsync" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
</div>

@code {
    private static readonly int[] GamesPerPairChoices = [2, 4, 6, 8, 10];

    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<ModelDto>? _models;
    private string? _modelsError;
    private CostInputsDto? _costs;
    private IReadOnlyList<ModelDto> _choices = [];

    private IReadOnlyList<TournamentDto>? _tournaments;
    private string? _listError;

    private string _name = "";
    private readonly HashSet<string> _selected = [];
    private int _gamesPerPair = 2;
    private int _maxConcurrency = TournamentFormRules.MaxConcurrencyLimit;
    private bool _submitting;
    private string? _createError;
    private TournamentCreatedDto? _created;

    /// <summary>The selected models, in the order the form lists them.</summary>
    private IReadOnlyList<string> SelectedModels =>
        _choices.Where(model => _selected.Contains(model.Id)).Select(model => model.Id).ToArray();

    private IReadOnlyList<string> Problems =>
        TournamentFormRules.Problems(_name, SelectedModels, _gamesPerPair, _maxConcurrency);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _models = await Api.GetModelsAsync(_cts.Token);
            _choices = _models.Where(model => model.Enabled).ToArray();
        }
        catch (HttpRequestException ex)
        {
            _modelsError = ex.Message;
        }

        await LoadCostInputsAsync();
        await LoadTournamentsAsync(_cts.Token);
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        var ct = _cts.Token;
        using var timer = new PeriodicTimer(TournamentFormat.RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // The fields change on a timer thread, outside any UI event: re-render explicitly.
                await InvokeAsync(async () =>
                {
                    await LoadTournamentsAsync(ct);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadTournamentsAsync(CancellationToken ct)
    {
        try
        {
            _tournaments = await Api.GetTournamentsAsync(ct);
            _listError = null;
        }
        catch (HttpRequestException ex)
        {
            _listError = ex.Message;
        }
    }

    private Task ReloadListAsync() => LoadTournamentsAsync(_cts.Token);

    private void Toggle(string modelId, object? selected)
    {
        if (selected is true)
        {
            _selected.Add(modelId);
        }
        else
        {
            _selected.Remove(modelId);
        }
    }

    private ModelDto? Find(string modelId) => _models?.FirstOrDefault(model => model.Id == modelId);

    /// <summary>One model's estimate in this tournament: the games it plays, at its moves on one side each.</summary>
    private CostPreview.Estimate? CostOf(string modelId, int gamesPerModel) =>
        _costs is { } costs && Find(modelId) is { } model
            ? CostPreview.For(model, costs, gamesPerModel * CostPreview.MovesPerSidePerGame)
            : null;

    private double? KnownCredits(IEnumerable<string> modelIds, int gamesPerModel) =>
        Known(modelIds.Select(id => CostOf(id, gamesPerModel)?.AiCredits));

    private double? KnownUsd(IEnumerable<string> modelIds, int gamesPerModel) =>
        Known(modelIds.Select(id => CostOf(id, gamesPerModel)?.Usd));

    /// <summary>The sum of the known figures, or null when none is known.</summary>
    private static double? Known(IEnumerable<double?> values)
    {
        var known = values.OfType<double>().ToList();
        return known.Count == 0 ? null : known.Sum();
    }

    /// <summary>The API's rate and tokens. Null when they could not be loaded: the form then shows premium requests only.</summary>
    private async Task LoadCostInputsAsync()
    {
        try
        {
            _costs = await Api.GetCostInputsAsync(_cts.Token);
        }
        catch (HttpRequestException)
        {
            _costs = null;
        }
    }

    private async Task StartAsync()
    {
        _submitting = true;
        _createError = null;
        _created = null;
        try
        {
            var request = new CreateTournamentRequest(_name.Trim(), SelectedModels, _gamesPerPair, _maxConcurrency);
            _created = await Api.CreateTournamentAsync(request, _cts.Token);
            _name = "";
            _selected.Clear();
            await LoadTournamentsAsync(_cts.Token);
        }
        catch (HttpRequestException ex)
        {
            _createError = $"The tournament was not created: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose() => _cts.Cancel();
}
