@page "/games"
@using Chess.Web.Api
@using Chess.Web.Components.Shared.Game
@using Chess.Web.Components.Pages.Shared
@implements IDisposable
@inject ArenaApiClient Api
@inject NavigationManager Navigation

<PageTitle>Games · LLM Chess Arena</PageTitle>

<header class="page-header">
    <h1>Games</h1>
    <p class="page-lede">Every game the arena has played. Open one to replay its moves.</p>
</header>

<div class="field-row games-filters">
    <label class="field">
        Player
        <select id="games-filter-model" data-testid="games-filter-model" @bind="_model" @bind:after="ApplyFilter">
            <option value="">Any player</option>
            @foreach (var player in Players)
            {
                <option value="@player.Id">@player.Label</option>
            }
        </select>
    </label>

    <label class="field">
        Status
        <select id="games-filter-status" data-testid="games-filter-status" @bind="_status" @bind:after="ApplyFilter">
            <option value="">Any status</option>
            <option value="queued">Queued</option>
            <option value="running">Running</option>
            <option value="finished">Finished</option>
        </select>
    </label>
</div>

@if (_modelsError is not null)
{
    <p class="callout callout-danger" role="alert">Could not load the players for the filter: @_modelsError</p>
}

@if (_listError is not null)
{
    <p class="callout callout-danger" role="alert" data-testid="games-error">Could not load the games: @_listError</p>
}

@if (_loading && _page is not null)
{
    <p class="muted" role="status" data-testid="games-loading">Loading games…</p>
}

@if (_page is null)
{
    @if (_listError is null)
    {
        <p>Loading games…</p>
    }
}
else if (_page.Items.Count == 0)
{
    <p class="empty-state" data-testid="games-empty">
        @(Filtered ? "No games match these filters." : "No games yet. Start one on the Live game page.")
    </p>
}
else
{
    var pageCount = GameArchive.PageCount(_page.Total);

    <div class="table-wrap" tabindex="0" role="region" aria-label="Games (scrollable table)">
        <table class="table-compact games-table" data-testid="games-table">
            <thead>
                <tr>
                    <th>Played (UTC)</th>
                    <th>White</th>
                    <th>Black</th>
                    <th>Result</th>
                    <th>Termination</th>
                    <th class="num">Plies</th>
                    <th>State</th>
                    <th class="num" title="Estimated from the AI credits of the game (03 §10.2). — when unknown.">Est. USD</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var game in _page.Items)
                {
                    <tr @key="game.Id" data-testid="game-row" data-game-id="@game.Id">
                        <td><a href="/games/@game.Id" title="@GameFormat.When(game.CreatedAt)">@GameFormat.Compact(game.CreatedAt)</a></td>
                        <td>@game.White.ModelId</td>
                        <td>@game.Black.ModelId</td>
                        <td><span class="badge @GameFormat.ResultTone(game.Result)" title="@GameFormat.ResultMeaning(game.Result)">@game.Result</span></td>
                        <td>@GameFormat.Termination(game.Termination)</td>
                        <td class="num">@game.PlyCount</td>
                        <td>@GameFormat.State(game.State)</td>
                        <td class="num" data-testid="game-cost">@GameFigures.Usd(_costs.GetValueOrDefault(game.Id))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="cluster games-pager" aria-label="Pages of games">
        <button id="games-prev" class="btn btn-sm" data-testid="games-prev" type="button" disabled="@(_loading || _pageNumber <= 1)" @onclick="PreviousPageAsync">Previous</button>
        <span data-testid="games-page">Page @_pageNumber of @pageCount · @_page.Total @(_page.Total == 1 ? "game" : "games")</span>
        <button id="games-next" class="btn btn-sm" data-testid="games-next" type="button" disabled="@(_loading || _pageNumber >= pageCount)" @onclick="NextPageAsync">Next</button>
    </nav>
}

@code {
    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<PlayerOption> _players = [];
    private string? _modelsError;
    private PageDto<GameSummaryDto>? _page;
    private Dictionary<Guid, double?> _costs = [];
    private string? _listError;
    private bool _loading;
    private string _model = "";
    private string _status = "";
    private int _pageNumber = 1;
    private (string Model, string Status, int Page)? _loaded;
    private int _loadId;
    private int _shownPage = 1;

    /// <summary>The filters and the page live in the address, so a link, a reload and Back all show the same list.</summary>
    [SupplyParameterFromQuery(Name = "model")]
    public string? ModelQuery { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    private bool Filtered => _model.Length > 0 || _status.Length > 0;

    /// <summary>The players to pick from. A player the address names that no list knows is kept, so the picker can show it.</summary>
    private IReadOnlyList<PlayerOption> Players =>
        _model.Length == 0 || _players.Any(player => player.Id == _model)
            ? _players
            : [.. _players, new PlayerOption(_model, _model)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _players = await PlayerOptions.LoadAsync(Api, includeCatalogue: true, _cts.Token);
        }
        catch (Exception ex) when (ApiFailure.IsFailure(ex, _cts.Token))
        {
            _modelsError = ApiFailure.Describe(ex);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _model = ModelQuery ?? "";
        _status = StatusQuery ?? "";
        _pageNumber = Math.Max(1, PageQuery ?? 1);

        // The address is the state: the list is loaded again only when what it names has changed.
        var wanted = (_model, _status, _pageNumber);
        if (_loaded != wanted)
        {
            _loaded = wanted;
            await LoadAsync();
        }
    }

    /// <summary>A new filter starts the archive again from its first page.</summary>
    private void ApplyFilter() => Show(_model, _status, 1);

    private Task PreviousPageAsync() => GoToPageAsync(_pageNumber - 1);

    private Task NextPageAsync() => GoToPageAsync(_pageNumber + 1);

    private Task GoToPageAsync(int page)
    {
        Show(_model, _status, page);
        return Task.CompletedTask;
    }

    /// <summary>Writes the filters into the address (replacing the entry, so Back leaves the list) and so loads them.</summary>
    private void Show(string model, string status, int page) =>
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["model"] = Filter(model),
                ["status"] = Filter(status),
                ["page"] = page > 1 ? page : null,
            }),
            replace: true);

    private async Task LoadAsync()
    {
        // A newer load supersedes one still in flight, so a slow answer cannot overwrite the filters on screen.
        var loadId = ++_loadId;
        var wantedPage = _pageNumber;
        // The user sees at once that a request is out: with the API slow, a click otherwise shows nothing for a minute.
        _loading = true;
        try
        {
            var page = await Api.GetGamesAsync(wantedPage, GameArchive.PageSize, Filter(_model), Filter(_status), _cts.Token);
            var costs = await LoadCostsAsync(page.Items);
            if (loadId != _loadId)
            {
                return;
            }

            _page = page;
            _costs = costs;
            _listError = null;
            _shownPage = wantedPage;
        }
        catch (Exception ex) when (ApiFailure.IsFailure(ex, _cts.Token))
        {
            if (loadId == _loadId)
            {
                _listError = ApiFailure.Describe(ex);
                // The list that is still on screen is the one the pager names.
                _pageNumber = _shownPage;
            }
        }
        finally
        {
            if (loadId == _loadId)
            {
                _loading = false;
            }
        }
    }

    /// <summary>Each game's estimated USD from its usage (03 §10.2). A game whose usage cannot be read shows a dash.</summary>
    private async Task<Dictionary<Guid, double?>> LoadCostsAsync(IReadOnlyList<GameSummaryDto> games)
    {
        var costs = await Task.WhenAll(games.Select(async game => (game.Id, Usd: await EstimatedUsdAsync(game.Id))));
        return costs.ToDictionary(cost => cost.Id, cost => cost.Usd);
    }

    private async Task<double?> EstimatedUsdAsync(Guid id)
    {
        try
        {
            return (await Api.GetGameUsageAsync(id, _cts.Token)).TotalEstimatedUsd;
        }
        catch (Exception ex) when (ApiFailure.IsFailure(ex, _cts.Token))
        {
            return null;
        }
    }

    /// <summary>The empty choice means no filter, so the API receives no parameter for it.</summary>
    private static string? Filter(string choice) => choice.Length == 0 ? null : choice;

    public void Dispose() => _cts.Cancel();
}
