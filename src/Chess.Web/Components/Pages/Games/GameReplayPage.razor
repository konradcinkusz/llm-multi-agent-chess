@page "/games/{Id:guid}"
@using System.Net
@using Chess.Web.Api
@using Chess.Web.Components.Shared
@using Chess.Web.Components.Shared.Game
@implements IDisposable
@inject ArenaApiClient Api

<PageTitle>Game replay · LLM Chess Arena</PageTitle>

<p class="replay-back"><a href="/games">All games</a></p>

@if (_error is not null)
{
    <p class="callout callout-danger" role="alert" data-testid="replay-error">@_error</p>
}
else if (_game is not { } game)
{
    <p>Loading game…</p>
}
else
{
    var summary = game.Summary;
    var fen = Replay.FenAt(game, _ply);
    var lastMove = Replay.LastMove(game, _ply);
    var move = _ply == 0 ? null : game.Moves[_ply - 1];
    var lastPly = game.Moves.Count;

    <header class="page-header">
        <h1>@GameFormat.Matchup(summary)</h1>
        <p class="page-lede replay-summary" data-testid="replay-summary">
            @GameFormat.State(summary.State) · result @summary.Result · @GameFormat.Termination(summary.Termination) ·
            @summary.PlyCount plies · @GameFormat.When(summary.CreatedAt)
            @if (summary.TournamentId is { } tournamentId)
            {
                <span> · <a href="/tournaments/@tournamentId">Tournament</a></span>
            }
        </p>
    </header>

    @if (summary.State != "finished")
    {
        <p class="callout callout-warning" role="status">
            This game has not finished, so the replay shows only the moves played so far.
        </p>
    }

    <div class="replay-layout">
        <div class="card stack replay-main">
            <div class="replay-board" tabindex="0" role="region" data-testid="replay-board"
                 aria-label="Replay board. Use the arrow keys to step through the moves."
                 @onkeydown="OnKey">
                <ChessBoardSvg Fen="@fen" LastMove="@lastMove" />
            </div>

            <div class="replay-controls">
                <div class="replay-buttons" role="group" aria-label="Replay controls">
                    <button type="button" class="btn" data-testid="replay-first" disabled="@(_ply == 0)" @onclick="First">First</button>
                    <button type="button" class="btn" data-testid="replay-prev" disabled="@(_ply == 0)" @onclick="Previous">Previous</button>
                    <button type="button" class="btn" data-testid="replay-next" disabled="@(_ply == lastPly)" @onclick="Next">Next</button>
                    <button type="button" class="btn" data-testid="replay-last" disabled="@(_ply == lastPly)" @onclick="Last">Last</button>
                </div>
                <span class="replay-ply" data-testid="replay-ply" aria-live="polite">Ply @_ply of @lastPly</span>
            </div>
            <p class="muted">Click the board, then use the arrow keys, Home and End to step through the moves.</p>

            @if (_pgnHref is { } href)
            {
                <div class="cluster">
                    <a class="btn btn-sm" data-testid="pgn-download" href="@href" download="@PgnDownload.FileName(summary.Id)">Download PGN</a>
                </div>
            }
            else if (_pgnError is not null)
            {
                <p class="callout callout-danger" role="alert">The PGN could not be loaded: @_pgnError</p>
            }
            else
            {
                <p class="muted" data-testid="pgn-unavailable">The PGN is available once the game has finished.</p>
            }
        </div>

        <aside class="stack replay-side">
            <MoveDetails Move="@move" />

            <section class="card stack" aria-labelledby="replay-moves-heading">
                <h2 id="replay-moves-heading" class="card-title">Moves</h2>
                <MoveTable Moves="@game.Moves" SelectedPly="@SelectedPly" OnSelect="@SelectMove" />
            </section>
        </aside>
    </div>

    <section class="card stack replay-summary-card" aria-labelledby="replay-summary-heading" data-testid="game-summary">
        <div class="card-header">
            <h2 id="replay-summary-heading" class="card-title">Game summary</h2>
            <span class="muted">Tokens and estimated cost, per side</span>
        </div>
        <GameUsageSummary Usage="@_usage" Message="@_usageMessage" ModelName="@ModelName" />
    </section>

    <section class="card stack replay-log" aria-labelledby="replay-log-heading" data-testid="engine-panel">
        <div class="card-header">
            <h2 id="replay-log-heading" class="card-title">Engine log</h2>
            <span class="muted">Every reply the models sent to the engine, newest first</span>
        </div>
        @if (_attemptsError is not null)
        {
            <p class="callout callout-danger" role="alert" data-testid="attempts-error">Could not load the engine log: @_attemptsError</p>
        }
        <EngineLog Entries="@_attempts" SelectedPly="@SelectedPly" ModelName="@ModelName" />
    </section>
}

@code {
    private const int MaxAttemptPages = 50;

    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<ModelDto> _models = [];
    private Guid? _loadedId;
    private GameDetailDto? _game;
    private string? _error;
    private string? _pgnHref;
    private string? _pgnError;
    private IReadOnlyList<EngineEntry> _attempts = [];
    private string? _attemptsError;
    private GameUsageDto? _usage;
    private string? _usageMessage;
    private int _ply;

    /// <summary>The game to replay, from the route.</summary>
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>The ply on the board, highlighted in the move table and the engine log. The start position has none.</summary>
    private int? SelectedPly => _ply == 0 ? null : _ply;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _models = await Api.GetModelsAsync(_cts.Token);
        }
        catch (HttpRequestException)
        {
            // The names are a nicety: without the models the log and the summary show the model ids.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync(Id);
    }

    private async Task LoadAsync(Guid id)
    {
        _game = null;
        _error = null;
        _pgnHref = null;
        _pgnError = null;
        _attempts = [];
        _attemptsError = null;
        _usage = null;
        _usageMessage = null;
        _ply = 0;

        try
        {
            _game = await Api.GetGameAsync(id, _cts.Token);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _error = "No game has this id.";
            return;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not load the game: {ex.Message}";
            return;
        }

        await LoadAttemptsAsync(id);

        // The PGN is written when the game ends, and so is the usage summary: only a finished game has them.
        if (_game.Summary.State == "finished")
        {
            await LoadPgnAsync(id);
            await LoadUsageAsync(id);
        }
        else
        {
            _usageMessage = "The summary is available once the game has finished.";
        }
    }

    /// <summary>The engine log of the game: every attempt the API has, page by page.</summary>
    private async Task LoadAttemptsAsync(Guid id)
    {
        try
        {
            var entries = new List<EngineEntry>();
            for (var page = 1; page <= MaxAttemptPages; page++)
            {
                var result = await Api.GetAttemptsAsync(id, null, page, _cts.Token);
                entries.AddRange(result.Items.Where(attempt => attempt.GameId == id).Select(EngineEntry.From));
                if (result.Items.Count == 0 || page * result.PageSize >= result.Total)
                {
                    break;
                }
            }

            _attempts = entries;
        }
        catch (HttpRequestException ex)
        {
            _attemptsError = ex.Message;
        }
    }

    private async Task LoadPgnAsync(Guid id)
    {
        try
        {
            _pgnHref = PgnDownload.Href(await Api.GetGamePgnAsync(id, _cts.Token));
        }
        catch (HttpRequestException ex)
        {
            _pgnError = ex.Message;
        }
    }

    private async Task LoadUsageAsync(Guid id)
    {
        try
        {
            _usage = await Api.GetGameUsageAsync(id, _cts.Token);
        }
        catch (HttpRequestException ex)
        {
            _usageMessage = $"Could not load the usage of this game: {ex.Message}";
        }
    }

    private string ModelName(string modelId) => _models.FirstOrDefault(model => model.Id == modelId)?.DisplayName ?? modelId;

    private void GoTo(int ply) => _ply = Replay.Clamp(ply, _game?.Moves.Count ?? 0);

    /// <summary>Picking a move in the table jumps to it. Picking the move on the board again sends null, which keeps the ply.</summary>
    private void SelectMove(int? ply)
    {
        if (ply is { } chosen)
        {
            GoTo(chosen);
        }
    }

    private void First() => GoTo(0);

    private void Previous() => GoTo(_ply - 1);

    private void Next() => GoTo(_ply + 1);

    private void Last() => GoTo(_game?.Moves.Count ?? 0);

    private void OnKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowLeft":
                Previous();
                break;
            case "ArrowRight":
                Next();
                break;
            case "Home":
                First();
                break;
            case "End":
                Last();
                break;
        }
    }

    public void Dispose() => _cts.Cancel();
}
