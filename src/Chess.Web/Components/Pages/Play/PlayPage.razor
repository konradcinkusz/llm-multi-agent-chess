@page "/"
@using Chess.Web.Api
@using Chess.Web.Components.Shared
@using Chess.Web.Components.Pages.Tournaments
@using Chess.Web.Components.Shared.Game
@implements IDisposable
@inject ArenaApiClient Api
@inject GameEventsClient Events
@inject IConfiguration Configuration

<PageTitle>Live game · LLM Chess Arena</PageTitle>

<header class="page-header">
    <h1>Live game</h1>
    <p class="page-lede">Choose two players, start a game and follow each move as it is played.</p>
</header>

@if (_models is null && _modelsError is null)
{
    <p>Loading models…</p>
}
else if (_modelsError is not null)
{
    <p class="callout callout-danger" role="alert">Could not load the models: @_modelsError</p>
}
else
{
    <div class="play-layout">
        <section class="card stack play-setup" aria-labelledby="players-heading">
            <h2 id="players-heading" class="card-title">Players</h2>

            @if (_gatewayMessage is not null)
            {
                <div class="callout callout-warning" role="alert" data-testid="gateway-banner">@_gatewayMessage</div>
            }

            @if (_stylesNotice is not null)
            {
                <p class="field-hint" data-testid="styles-notice">@_stylesNotice</p>
            }

            <label class="field">
                <span class="play-side-name"><span class="play-side-chip" aria-hidden="true">♔</span>White</span>
                <select id="white-model" data-testid="white-model" @bind="_white" disabled="@PickersLocked">
                    @foreach (var choice in _choices)
                    {
                        <option value="@choice.Model.Id" disabled="@(!choice.Selectable)">@PlayChoices.Label(choice.Model)</option>
                    }
                </select>
            </label>

            @if (_white != PlayChoices.Random)
            {
                <label class="field">
                    White's prompt style
                    <select id="white-style" data-testid="white-style" @bind="_whiteStyle" disabled="@PickersLocked">
                        @foreach (var style in _styles)
                        {
                            <option value="@style.Id">@style.DisplayName</option>
                        }
                    </select>
                    <span class="field-hint">@PromptStyleChoices.Describe(_styles, _whiteStyle)</span>
                </label>
            }

            <label class="field">
                <span class="play-side-name"><span class="play-side-chip" aria-hidden="true">♚</span>Black</span>
                <select id="black-model" data-testid="black-model" @bind="_black" disabled="@PickersLocked">
                    @foreach (var choice in _choices)
                    {
                        <option value="@choice.Model.Id" disabled="@(!choice.Selectable)">@PlayChoices.Label(choice.Model)</option>
                    }
                </select>
            </label>

            @if (_black != PlayChoices.Random)
            {
                <label class="field">
                    Black's prompt style
                    <select id="black-style" data-testid="black-style" @bind="_blackStyle" disabled="@PickersLocked">
                        @foreach (var style in _styles)
                        {
                            <option value="@style.Id">@style.DisplayName</option>
                        }
                    </select>
                    <span class="field-hint">@PromptStyleChoices.Describe(_styles, _blackStyle)</span>
                </label>
            }

            <label class="play-check">
                <input type="checkbox" id="rated" data-testid="rated-toggle" @bind="_rated" disabled="@PickersLocked" />
                Rated game
            </label>

            <div class="cluster">
                <button type="button" class="btn btn-primary" data-testid="start-game" disabled="@(!CanStart)" @onclick="StartAsync">Start game</button>
                @if (IsLive)
                {
                    <button type="button" class="btn btn-danger" data-testid="abort-game" @onclick="AbortAsync">Abort</button>
                }
            </div>

            @if (_error is not null)
            {
                <p class="callout callout-danger" role="alert" data-testid="play-error">@_error</p>
            }
        </section>

        <section class="card stack play-board" aria-label="Board">
            <PlayerBar Color="Black" Name="@ModelName(SideModel(Black))" ToMove="@ToMove(Black)"
                       Attempt="@AttemptOf(Black)" Seconds="@SecondsOf(Black)"
                       CapturedHere="@Captured.CapturedByBlack" Lead="@LeadOf(Black)"
                       Totals="@Totals(Black)" UsdPerAiCredit="@UsdPerAiCredit" />

            <div class="play-board-frame" data-testid="board">
                <ChessBoardSvg Fen="@BoardFen" LastMove="@Shown?.LastMove" CheckSquare="@Shown?.CheckSquare" />
            </div>

            <PlayerBar Color="White" Name="@ModelName(SideModel(White))" ToMove="@ToMove(White)"
                       Attempt="@AttemptOf(White)" Seconds="@SecondsOf(White)"
                       CapturedHere="@Captured.CapturedByWhite" Lead="@LeadOf(White)"
                       Totals="@Totals(White)" UsdPerAiCredit="@UsdPerAiCredit" />

            <p class="play-status" data-testid="game-status" role="status">@StatusLine</p>

            @if (Shown?.Outcome is { } outcome)
            {
                <p class="play-result">
                    <span class="badge @PlayChoices.OutcomeTone(outcome)" data-testid="game-result">@PlayChoices.Outcome(outcome)</span>
                </p>

                @if (PlayChoices.ForfeitNotice(outcome.Termination) is { } forfeit)
                {
                    <p class="callout callout-warning play-notice" data-testid="forfeit-notice">@forfeit</p>
                }
            }

            @if (Shown is { Notices.Count: > 0 } notices)
            {
                <ul class="play-notices" data-testid="attempt-notices">
                    @foreach (var notice in notices.Notices)
                    {
                        <li>
                            @notice.Color's attempt @notice.Attempt at ply @notice.Ply was not a legal move: @notice.Reason
                            @if (notice.RawReply is not null)
                            {
                                <code>@notice.RawReply</code>
                            }
                        </li>
                    }
                </ul>
            }

            @if (Shown is { IsFinished: true })
            {
                <div class="cluster">
                    <button type="button" class="btn btn-sm" data-testid="pgn-toggle" @onclick="TogglePgnAsync">
                        @(_pgn is null ? "Show PGN" : "Hide PGN")
                    </button>
                </div>

                @if (_pgn is not null)
                {
                    <pre class="play-pgn" data-testid="pgn">@_pgn</pre>
                }
            }
        </section>

        <aside class="card stack play-moves" aria-labelledby="moves-heading">
            <h2 id="moves-heading" class="card-title">Moves</h2>
            <fieldset class="play-pace" data-testid="pace">
                <legend>Pace</legend>
                <div class="chips">
                    @foreach (var option in PlayChoices.Paces)
                    {
                        <label class="chip">
                            <input type="radio" name="viewer-pace" value="@((int)option.Pause.TotalSeconds)" data-testid="pace-option"
                                   checked="@(_pace.Pause == option.Pause)" @onchange="() => SetPace(option.Pause)" />
                            @option.Label
                        </label>
                    }
                </div>
                @if (Behind > 0)
                {
                    <p class="play-pace-behind" data-testid="pace-behind">
                        <span>@PlayChoices.Behind(Behind)</span>
                        <button type="button" class="btn btn-sm" data-testid="catch-up" @onclick="CatchUp">Catch up</button>
                    </p>
                }
            </fieldset>
            <MoveTable Moves="@Moves" PendingPly="@PendingPly" SelectedPly="@_selectedPly" OnSelect="@SelectPly" />
        </aside>
    </div>

    @if (Shown is { IsFinished: true })
    {
        <section class="card stack play-summary" aria-labelledby="summary-heading" data-testid="game-summary">
            <div class="card-header">
                <h2 id="summary-heading" class="card-title">Game summary</h2>
                <span class="muted">Tokens and estimated cost, per side</span>
            </div>
            <GameUsageSummary Usage="@_usage" Message="@_usageError" ModelName="@ModelName" />
        </section>
    }

    <section class="card stack play-log" aria-labelledby="log-heading" data-testid="engine-panel">
        <div class="card-header">
            <h2 id="log-heading" class="card-title">Engine log</h2>
            <span class="muted">Every reply the models sent to the engine, newest first</span>
        </div>
        <EngineLog Entries="@Attempts" SelectedPly="@_selectedPly" ModelName="@ModelName" />
    </section>
}

@code {
    /// <summary>How long to wait before reconnecting a stream that closed before the game finished.</summary>
    private static readonly TimeSpan ReconnectDelay = TimeSpan.FromSeconds(2);

    /// <summary>The most pages of attempts a game's engine log loads. A game is far shorter than this.</summary>
    private const int MaxAttemptPages = 50;

    private const string White = "White";
    private const string Black = "Black";

    private IReadOnlyList<ModelDto>? _models;
    private IReadOnlyList<ModelChoice> _choices = [];
    private string? _modelsError;
    private string? _gatewayMessage;

    private string _white = PlayChoices.Random;
    private string _black = PlayChoices.Random;
    private string _whiteStyle = PlayerId.DefaultStyle;
    private string _blackStyle = PlayerId.DefaultStyle;
    private IReadOnlyList<PromptStyleDto> _styles = [PromptStyleChoices.Classic];
    private string? _stylesNotice;
    private bool _rated = true;
    private bool _starting;

    /// <summary>
    /// False until the circuit has rendered the page. The prerendered page is static markup: a choice made on it is never
    /// sent to the server, so its pickers stay disabled until the circuit binds them.
    /// </summary>
    private bool _bound;
    private string? _error;

    /// <summary>How often the pacing loop checks whether the next move may be shown.</summary>
    private static readonly TimeSpan PaceCheck = TimeSpan.FromMilliseconds(250);

    private LiveGame? _live;
    private CancellationTokenSource? _follow;

    /// <summary>The viewer pace (03 §10.5). The page starts at the configured pace and keeps the choice while it stays open.</summary>
    private ViewerPacer _pace = new(TimeProvider.System);

    /// <summary>The view of the game, rebuilt only when the game, its version or the shown ply changes.</summary>
    private LiveGame? _shown;
    private (LiveGame? Game, int Version, int Ply) _shownKey;
    private string? _pgn;
    private GameUsageDto? _usage;
    private string? _usageError;
    private int? _selectedPly;

    /// <summary>Opened by ?game=, or started here: the game the page follows.</summary>
    [SupplyParameterFromQuery(Name = "game")]
    public Guid? Game { get; set; }

    /// <summary>The clock the viewer pace reads. The system clock unless a test supplies its own.</summary>
    [Parameter]
    public TimeProvider? Clock { get; set; }

    private bool IsLive => _live is { IsFinished: false };

    private bool PickersLocked => IsLive || !_bound;

    /// <summary>
    /// What the page shows: the game as far as the viewer pace has released it (03 §10.5). The markup reads this many
    /// times per render, so it is built once per change.
    /// </summary>
    private LiveGame? Shown
    {
        get
        {
            if (_live is null)
            {
                return null;
            }

            var key = (_live, _live.Version, _pace.ShownPly);
            if (_shown is null || _shownKey != key)
            {
                _shown = _live.ShownUpTo(_pace.ShownPly);
                _shownKey = key;
            }

            return _shown;
        }
    }

    /// <summary>The moves the game has played that the page is not showing yet.</summary>
    private int Behind => _live is null ? 0 : _pace.Behind(_live.AppliedPly);

    private bool CanStart => _bound && _models is not null && !_starting && !IsLive && IsSelectable(_white) && IsSelectable(_black);

    private string BoardFen => Shown?.CurrentFen ?? LiveGame.StartFen;

    private IReadOnlyList<MoveDto> Moves => Shown?.Moves ?? [];

    private IReadOnlyList<EngineEntry> Attempts => Shown?.Attempts ?? [];

    /// <summary>The pieces each side has captured and the lead, from the moves so far.</summary>
    private Material Captured => BoardFacts.MaterialOf(LiveGame.StartFen, Moves.Select(move => move.FenAfter));

    /// <summary>The ply a model is deciding now, shown as a pending cell in the move table.</summary>
    private int? PendingPly => Shown is { IsFinished: false, Thinking: { } thinking } ? thinking.Ply : null;

    private double UsdPerAiCredit => _usage?.UsdPerAiCredit ?? GameFigures.DefaultUsdPerAiCredit;

    private string StatusLine => Shown switch
    {
        null => "No game yet. Choose two players and start one.",
        { IsFinished: true } => "Game over.",
        { Summary.State: "queued" } => "Queued, waiting for a free game slot.",
        { Thinking: { } thinking } =>
            $"Move {MoveNumber(thinking.Ply)} · {thinking.Color} to move · {ModelName(thinking.ModelId)} is thinking " +
            $"(attempt {Math.Min(thinking.Attempt, EngineEntry.MaxAttempts)} of {EngineEntry.MaxAttempts})",
        var shown => $"Move {MoveNumber(shown.NextPly)} · {LiveGame.ColorOf(shown.NextPly)} to move",
    };

    protected override async Task OnInitializedAsync()
    {
        _pace = new ViewerPacer(Clock ?? TimeProvider.System)
        {
            Pause = PlayChoices.DefaultPace(Configuration["Arena:Viewer:MinMovePauseSeconds"]),
        };

        IReadOnlyList<ModelDto>? models = null;
        StatusDto? status = null;
        string? statusError = null;

        try
        {
            models = await Api.GetModelsAsync();
        }
        catch (Exception ex)
        {
            _modelsError = ex.Message;
        }

        try
        {
            status = await Api.GetStatusAsync();
        }
        catch (Exception ex)
        {
            statusError = ex.Message;
        }

        _gatewayMessage = GatewayMessage(status, statusError);

        var styles = await PromptStyleChoices.LoadAsync(Api, CancellationToken.None);
        _styles = styles.Styles;
        _stylesNotice = styles.Notice;

        if (models is null)
        {
            return;
        }

        _models = models;
        _choices = PlayChoices.Choices(models, PlayChoices.GatewayReady(status));
        _white = PlayChoices.Default(_choices, 0);
        _black = PlayChoices.Default(_choices, 1);

        if (Game is { } gameId)
        {
            await OpenAsync(gameId);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !_bound)
        {
            _bound = true;
            StateHasChanged();
        }
    }

    private async Task StartAsync()
    {
        _starting = true;
        _error = null;
        _pgn = null;
        _usage = null;
        _usageError = null;
        _selectedPly = null;
        StopFollowing();

        try
        {
            var white = PromptStyleChoices.Player(_white, null, _whiteStyle);
            var black = PromptStyleChoices.Player(_black, null, _blackStyle);
            var summary = await Api.CreateGameAsync(
                new CreateGameRequest(PlayChoices.Player(white), PlayChoices.Player(black), _rated));
            _live = new LiveGame(summary);
            _pace.Reset(0);

            _follow = new CancellationTokenSource();
            _ = FollowAsync(summary.Id, _follow.Token);
        }
        catch (Exception ex)
        {
            _error = $"Could not start the game: {ex.Message}";
        }
        finally
        {
            _starting = false;
        }
    }

    /// <summary>Follows a game that already exists (a link with ?game=): running, queued or finished.</summary>
    private async Task OpenAsync(Guid gameId)
    {
        try
        {
            var detail = await Api.GetGameAsync(gameId);
            _live = new LiveGame(detail.Summary);
            _live.Load(detail);

            // A game opened mid-way shows its current position at once; only the moves that come after are paced.
            _pace.Reset(_live.AppliedPly);

            _follow = new CancellationTokenSource();
            _ = FollowAsync(gameId, _follow.Token);
        }
        catch (Exception ex)
        {
            _error = $"Could not open the game: {ex.Message}";
        }
    }

    private async Task AbortAsync()
    {
        if (_live is null)
        {
            return;
        }

        try
        {
            // The game ends through the stream: the server sends GameFinished with termination "aborted".
            await Api.AbortGameAsync(_live.GameId);
        }
        catch (Exception ex)
        {
            _error = $"Could not abort the game: {ex.Message}";
        }
    }

    private async Task TogglePgnAsync()
    {
        if (_pgn is not null)
        {
            _pgn = null;
            return;
        }

        if (_live is null)
        {
            return;
        }

        try
        {
            _pgn = await Api.GetGamePgnAsync(_live.GameId);
        }
        catch (Exception ex)
        {
            _error = $"Could not load the PGN: {ex.Message}";
        }
    }

    /// <summary>Changes the pace. Going to Live shows every move the game has at once.</summary>
    private void SetPace(TimeSpan pause)
    {
        _pace.Pause = pause;
        Release();
    }

    /// <summary>Shows everything the game has played, at once, and paces the moves after it.</summary>
    private void CatchUp()
    {
        if (_live is { } live)
        {
            _pace.Reset(live.AppliedPly);
        }
    }

    /// <summary>Releases the moves the pace allows now. Runs on the render thread.</summary>
    private bool Release() => _live is { } live && _pace.Advance(live.AppliedPly);

    /// <summary>
    /// Releases the moves that wait for the pause. Events and loads release a move at once when the pause allows; this loop
    /// releases the ones that waited. It ends once the game is over and every move is shown, or when the page leaves it.
    /// </summary>
    private async Task PaceAsync(Guid gameId, CancellationToken ct)
    {
        try
        {
            while (true)
            {
                var done = false;
                await InvokeAsync(() =>
                {
                    if (ct.IsCancellationRequested || _live is not { } live || live.GameId != gameId)
                    {
                        done = true;
                        return;
                    }

                    if (Release())
                    {
                        StateHasChanged();
                    }

                    done = live.IsFinished && Behind == 0;
                });

                if (done)
                {
                    return;
                }

                await Task.Delay(PaceCheck, ct);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The page left the game.
        }
    }

    /// <summary>Picking a move selects its entries in the engine log; picking it again clears the selection.</summary>
    private void SelectPly(int? ply) => _selectedPly = ply;

    /// <summary>
    /// Opens the stream first, then loads the game (03 §5.1). The stream replays nothing, so anything
    /// that happened before it connected is in the load; anything the load does not cover shows up on
    /// the stream as a gap and makes the page load again.
    /// </summary>
    private async Task FollowAsync(Guid gameId, CancellationToken ct)
    {
        try
        {
            var reading = ReadStreamAsync(gameId, ct);
            _ = TickAsync(ct);
            _ = PaceAsync(gameId, ct);
            await LoadAsync(gameId, ct);
            await reading;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The page left this game or started another one.
        }
    }

    private async Task ReadStreamAsync(Guid gameId, CancellationToken ct)
    {
        while (true)
        {
            try
            {
                await foreach (var message in Events.StreamAsync(gameId, ct))
                {
                    // ComponentBase.InvokeAsync has no Func<T> overload, so the result comes back through a local.
                    var result = ApplyResult.Unknown;
                    await InvokeAsync(() => result = ApplyEvent(gameId, message, ct));
                    if (result == ApplyResult.Gap)
                    {
                        await LoadAsync(gameId, ct);
                    }

                    if (message.Type == "GameFinished")
                    {
                        // The final state, the attempts and the usage of the finished game are loaded from the API.
                        await LoadAsync(gameId, ct);
                        return;
                    }
                }
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                await InvokeAsync(() => ShowError($"The live stream failed: {ex.Message}"));
            }

            // The stream closed before the game finished, or could not be opened: load the game as it is, then reconnect.
            await LoadAsync(gameId, ct);
            var over = false;
            await InvokeAsync(() => over = IsOver(gameId));
            if (over)
            {
                return;
            }

            await Task.Delay(ReconnectDelay, ct);
        }
    }

    /// <summary>Loads the game, then the engine log, and the usage once the game is over.</summary>
    private async Task LoadAsync(Guid gameId, CancellationToken ct)
    {
        GameDetailDto detail;
        try
        {
            detail = await Api.GetGameAsync(gameId, ct);
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            await InvokeAsync(() => ShowError($"Could not load the game: {ex.Message}"));
            return;
        }

        await InvokeAsync(() =>
        {
            if (!ct.IsCancellationRequested && _live is { } live && live.GameId == gameId)
            {
                live.Load(detail);
                Release();
                StateHasChanged();
            }
        });

        if (detail.Summary.State != "queued")
        {
            await LoadAttemptsAsync(gameId, ct);
        }

        if (detail.Summary.State == "finished")
        {
            await LoadUsageAsync(gameId, ct);
        }
    }

    /// <summary>The engine log of the game: every attempt the API has, page by page.</summary>
    private async Task LoadAttemptsAsync(Guid gameId, CancellationToken ct)
    {
        try
        {
            var entries = new List<EngineEntry>();
            for (var page = 1; page <= MaxAttemptPages; page++)
            {
                var result = await Api.GetAttemptsAsync(gameId, null, page, ct);
                entries.AddRange(result.Items.Where(attempt => attempt.GameId == gameId).Select(EngineEntry.From));
                if (result.Items.Count == 0 || page * result.PageSize >= result.Total)
                {
                    break;
                }
            }

            await InvokeAsync(() =>
            {
                if (!ct.IsCancellationRequested && _live is { } live && live.GameId == gameId)
                {
                    live.AddAttempts(entries);
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            await InvokeAsync(() => ShowError($"Could not load the engine log: {ex.Message}"));
        }
    }

    private async Task LoadUsageAsync(Guid gameId, CancellationToken ct)
    {
        try
        {
            var usage = await Api.GetGameUsageAsync(gameId, ct);
            await InvokeAsync(() =>
            {
                if (!ct.IsCancellationRequested && _live is { } live && live.GameId == gameId)
                {
                    _usage = usage;
                    _usageError = null;
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            await InvokeAsync(() =>
            {
                _usageError = $"Could not load the usage of this game: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    /// <summary>Re-renders once a second while a model is thinking, so the elapsed seconds keep counting.</summary>
    private async Task TickAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var running = false;
                await InvokeAsync(() =>
                {
                    running = _live is { IsFinished: false };
                    if (running && _live!.Thinking is not null)
                    {
                        StateHasChanged();
                    }
                });

                if (!running)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The page left the game.
        }
    }

    /// <summary>Runs on the render thread. Events for a game the page has left are dropped.</summary>
    private ApplyResult ApplyEvent(Guid gameId, GameEventMessage message, CancellationToken ct)
    {
        if (ct.IsCancellationRequested || _live is not { } live || live.GameId != gameId)
        {
            return ApplyResult.Unknown;
        }

        var result = live.Apply(message);
        Release();
        StateHasChanged();
        return result;
    }

    private bool IsOver(Guid gameId) => _live is not { } live || live.GameId != gameId || live.IsFinished;

    private void ShowError(string message)
    {
        _error = message;
        StateHasChanged();
    }

    private bool IsSelectable(string modelId) => _choices.Any(choice => choice.Model.Id == modelId && choice.Selectable);

    /// <summary>The model a side plays: the game's once there is one, else the picker's choice.</summary>
    private string SideModel(string color) => _live is { } live
        ? (color == White ? live.Summary.White : live.Summary.Black).ModelId
        : color == White ? _white : _black;

    /// <summary>A player's name on the board: its model, and its style when it is not classic.</summary>
    private string ModelName(string playerId) => PromptStyleChoices.Label(playerId, _models, _styles);

    /// <summary>Whose move it is: the side the game waits for, unless the game is over or not started.</summary>
    private bool ToMove(string color) => Shown is { IsFinished: false } shown && LiveGame.ColorOf(shown.NextPly) == color;

    private int? AttemptOf(string color) => Shown is { IsFinished: false, Thinking: { } thinking } && thinking.Color == color
        ? thinking.Attempt
        : null;

    private int SecondsOf(string color) => Shown is { IsFinished: false, Thinking: { } thinking } && thinking.Color == color
        ? Math.Max(0, (int)(DateTimeOffset.UtcNow - thinking.StartedAt).TotalSeconds)
        : 0;

    private SideTotals Totals(string color) => BoardFacts.Totals(Attempts, color);

    /// <summary>The material lead in points, on the side that has it.</summary>
    private int LeadOf(string color) => color == White ? Math.Max(0, Captured.Lead) : Math.Max(0, -Captured.Lead);

    private static int MoveNumber(int ply) => (ply + 1) / 2;

    /// <summary>Why the LLM players cannot be picked, or null when they can. Random is always available.</summary>
    private string? GatewayMessage(StatusDto? status, string? statusError)
    {
        if (status is null)
        {
            return statusError is null ? null : $"API status unavailable ({statusError}). Only Random can be selected.";
        }

        if (PlayChoices.GatewayReady(status))
        {
            return null;
        }

        return $"GitHub Copilot is not ready: {status.Copilot} ({status.CopilotDetail}). " +
            "Run `copilot` in a terminal, log in, then reload this page. Until then only Random can be selected.";
    }

    private void StopFollowing()
    {
        // Cancel only: disposing a source a reader may still hold a token from can throw in those readers.
        _follow?.Cancel();
        _follow = null;
    }

    public void Dispose() => StopFollowing();
}
