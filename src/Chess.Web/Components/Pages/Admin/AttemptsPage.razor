@page "/admin/attempts"
@using System.Text.Json
@using Chess.Web.Api
@using Chess.Web.Components.Pages.Games
@using Chess.Web.Components.Pages.Shared
@inject ArenaApiClient Api
@inject NavigationManager Navigation

<PageTitle>Attempts · LLM Chess Arena</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Attempts</h1>
        <p class="page-lede">Every prompt sent to a model and the reply it gave, newest first</p>
    </div>

    <form class="card stack" @onsubmit="ApplyFilters" @onsubmit:preventDefault="true">
        <div class="field-row">
            <div class="field">
                <label for="attempts-game">Game ID</label>
                <input id="attempts-game" type="text" class="game-id-input" @bind="_gameIdInput"
                       placeholder="paste game GUID…" aria-describedby="attempts-game-error" />
            </div>

            <div class="field">
                <label for="attempts-model">Model</label>
                <select id="attempts-model" @bind="_modelInput">
                    <option value="">All models</option>
                    @foreach (var player in Players)
                    {
                        <option value="@player.Id">@player.Label</option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="attempts-legal">Reply</label>
                <select id="attempts-legal" @bind="_legalInput">
                    <option value="all">All replies</option>
                    <option value="legal">Legal only</option>
                    <option value="illegal">Illegal only</option>
                </select>
            </div>
        </div>

        @if (_gameError is not null)
        {
            <p id="attempts-game-error" class="field-error error-text" role="alert">@_gameError</p>
        }

        <div class="cluster">
            <button type="submit" class="btn-primary">Apply</button>
            <button type="button" class="btn" @onclick="ClearFilters">Clear</button>
        </div>
    </form>

    @if (_error is not null)
    {
        <p class="error-msg callout callout-danger" role="alert">@_error</p>
    }
    else if (_loading)
    {
        <p class="loading-msg muted" role="status">Loading attempts...</p>
    }
    else if (_result is not null)
    {
        @if (_result.Items.Count == 0)
        {
            <p class="empty-state empty-msg">No attempts match these filters. Attempts are recorded when a player makes a move.</p>
        }
        else
        {
            <ol class="attempt-list stack">
                @foreach (var attempt in _result.Items)
                {
                    <li @key="(attempt.GameId, attempt.Ply, attempt.Number)" class="attempt @(attempt.Legal ? "" : "failed-attempt")">
                        <details>
                            <summary class="attempt-header">
                                <span class="badge badge-accent ply-badge">Ply @attempt.Ply</span>
                                <span class="badge color-badge @(IsWhite(attempt.Ply) ? "white-badge" : "black-badge")">@ColorOf(attempt.Ply)</span>
                                <span class="badge badge-neutral model-tag">@attempt.ModelId</span>
                                <span class="san">@(attempt.ParsedSan ?? "no move")</span>
                                <span class="attempt-number">Attempt @attempt.Number</span>
                                @if (!attempt.Legal)
                                {
                                    <span class="badge badge-danger fail-tag">ILLEGAL</span>
                                }
                                <span class="latency">@attempt.LatencyMs ms</span>
                            </summary>

                            <div class="attempt-meta">
                                <a href="/games/@attempt.GameId">Game @Short(attempt.GameId)</a>
                                <span class="date-sm">@GameFormat.When(attempt.CreatedAt)</span>
                            </div>

                            <div class="attempt-section">
                                <div class="section-label">PROMPT</div>
                                <pre class="prompt-text">@attempt.Prompt</pre>
                            </div>

                            <div class="attempt-section">
                                <div class="section-label @(attempt.Legal ? "success-label" : "fail-label")">
                                    REPLY @(attempt.Legal ? "(legal)" : "(illegal)")
                                </div>
                                @if (attempt.RawReply is not null)
                                {
                                    <pre class="reply-text @(attempt.Legal ? "valid-reply" : "invalid-reply")">@attempt.RawReply</pre>
                                }
                                else
                                {
                                    <p class="no-reply muted">No reply was recorded.</p>
                                }
                                @if (attempt.Error is not null)
                                {
                                    <p class="error-text">Error: @attempt.Error</p>
                                }
                            </div>
                        </details>
                    </li>
                }
            </ol>

        }

        <nav class="pagination" aria-label="Attempts pages">
            <button type="button" class="btn" @onclick="PrevPage" disabled="@(_page <= 1)">&#x2190; Prev</button>
            <span>Page @_page of @PageCount</span>
            <button type="button" class="btn" @onclick="NextPage" disabled="@(_page >= PageCount)">Next &#x2192;</button>
        </nav>
    }
</div>

@code {
    // The API filters by game, model and reply (legal or rejected), so every page of the log is already filtered.
    private sealed record Filters(Guid? GameId, string? Model, string Legal);

    private IReadOnlyList<PlayerOption> _players = [];
    private Filters _applied = new(null, null, "all");
    private PageDto<AttemptDto>? _result;
    private string? _error;
    private string? _gameError;
    private bool _loading = true;
    private int _page = 1;
    private int _loadId;
    private (Guid?, string?, string, int)? _loaded;

    // Form state, applied only when the user presses Apply.
    private string _gameIdInput = "";
    private string _modelInput = "";
    private string _legalInput = "all";

    /// <summary>The filters and the page live in the address, so a link, a reload and Back show the same log.</summary>
    [SupplyParameterFromQuery(Name = "game")]
    public string? GameQuery { get; set; }

    [SupplyParameterFromQuery(Name = "model")]
    public string? ModelQuery { get; set; }

    [SupplyParameterFromQuery(Name = "reply")]
    public string? ReplyQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    private int PageCount => _result is { PageSize: > 0 } r ? Math.Max(1, (r.Total + r.PageSize - 1) / r.PageSize) : 1;

    /// <summary>The players to pick from, and the one the address names when no list knows it, so the picker can show it.</summary>
    private IReadOnlyList<PlayerOption> Players =>
        _modelInput.Length == 0 || _players.Any(player => player.Id == _modelInput)
            ? _players
            : [.. _players, new PlayerOption(_modelInput, _modelInput)];

    protected override async Task OnInitializedAsync()
    {
        // The player list only feeds the filter; the log still loads when the ratings and models are unavailable.
        try
        {
            _players = await PlayerOptions.LoadAsync(Api, includeCatalogue: true, CancellationToken.None);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        {
            _players = [];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _gameIdInput = GameQuery ?? "";
        _modelInput = ModelQuery ?? "";
        _legalInput = ReplyQuery is "legal" or "illegal" ? ReplyQuery : "all";
        var page = Math.Max(1, PageQuery ?? 1);

        if (!TryParseGame(_gameIdInput, out var gameId))
        {
            _gameError = GameIdProblem;
            _loading = false;
            return;
        }

        _gameError = null;
        var wanted = (gameId, _modelInput.Length == 0 ? null : _modelInput, _legalInput, page);
        if (_loaded != wanted)
        {
            _loaded = wanted;
            _applied = new Filters(wanted.gameId, wanted.Item2, wanted.Item3);
            _page = page;
            await LoadAsync();
        }
    }

    private const string GameIdProblem = "Game ID must be a GUID, as shown in the games list.";

    private static bool TryParseGame(string text, out Guid? gameId)
    {
        gameId = null;
        var trimmed = text.Trim();
        if (trimmed.Length == 0)
        {
            return true;
        }

        if (!Guid.TryParse(trimmed, out var parsed))
        {
            return false;
        }

        gameId = parsed;
        return true;
    }

    private async Task ApplyFilters()
    {
        if (!TryParseGame(_gameIdInput, out var gameId))
        {
            _gameError = GameIdProblem;
            return;
        }

        _gameError = null;
        await ShowAsync(gameId, _modelInput, _legalInput, 1);
    }

    private Task ClearFilters()
    {
        _gameIdInput = "";
        _modelInput = "";
        _legalInput = "all";
        _gameError = null;
        return ShowAsync(null, "", "all", 1);
    }

    private Task PrevPage() => _page > 1 ? ShowAsync(_applied.GameId, _applied.Model ?? "", _applied.Legal, _page - 1) : Task.CompletedTask;

    private Task NextPage() => _page < PageCount ? ShowAsync(_applied.GameId, _applied.Model ?? "", _applied.Legal, _page + 1) : Task.CompletedTask;

    /// <summary>
    /// Writes the filters into the address (replacing the entry), which loads them. The same filters again reload the log,
    /// so Apply also refreshes it.
    /// </summary>
    private async Task ShowAsync(Guid? gameId, string model, string legal, int page)
    {
        var wanted = (gameId, model.Length == 0 ? null : model, legal, page);
        if (_loaded == wanted)
        {
            await LoadAsync();
            return;
        }

        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["game"] = gameId?.ToString("D"),
                ["model"] = model.Length == 0 ? null : model,
                ["reply"] = legal == "all" ? null : legal,
                ["page"] = page > 1 ? page : null,
            }),
            replace: true);
    }

    private async Task LoadAsync()
    {
        // A newer request supersedes an older one still in flight, so a slow response cannot overwrite the filters on screen.
        var loadId = ++_loadId;
        _loading = true;
        _error = null;
        try
        {
            bool? legal = _applied.Legal switch { "legal" => true, "illegal" => false, _ => null };
            var result = await Api.GetAttemptsAsync(_applied.GameId, _applied.Model, _page, legal: legal);
            if (loadId != _loadId)
            {
                return;
            }

            _result = result;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        {
            if (loadId != _loadId)
            {
                return;
            }

            _result = null;
            _error = "The attempts could not be loaded. Is the API running?";
        }
        finally
        {
            if (loadId == _loadId)
            {
                _loading = false;
            }
        }
    }

    // Attempts carry no side of their own: ply 1 is White's first move, so odd plies are White's (as on the API).
    private static bool IsWhite(int ply) => ply % 2 == 1;

    private static string ColorOf(int ply) => IsWhite(ply) ? "White" : "Black";

    private static string Short(Guid id) => id.ToString("D")[..8] + "…";
}
