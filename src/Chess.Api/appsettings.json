{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5080"
      }
    }
  },
  "Arena": {
    "MaxConcurrentGames": 2,
    "MaxAttemptsPerMove": 3,
    "MaxPlies": 200,
    "MoveTimeoutSeconds": 180,
    "ShowAutoModel": false,
    "Cost": {
      "UsdPerAiCredit": 0.01
    }
  },
  "Llm": {
    "Provider": "Copilot"
  },
  "Database": {
    "Provider": "PostgreSQL"
  },
  "Analysis": {
    "StockfishPath": "",
    "Depth": 12
  }
}
