@namespace ChessBlazor.Components
@using ChessBlazor.Models

<div class="game-controls">
    <div class="turn-info">
        @if (Game != null && !Game.IsGameOver)
        {
            <span class="turn-indicator @(Game.CurrentTurn == "White" ? "white-turn" : "black-turn")">
                @(Game.CurrentTurn == "White" ? "⬜" : "⬛") @Game.CurrentTurn to move
            </span>
        }
        <StatusBadge Status="@(Game?.Status ?? "")" />
    </div>

    @if (Game != null && !Game.IsGameOver)
    {
        <div class="control-buttons">
            <button class="btn btn-secondary" @onclick="OnStepClicked"
                    disabled="@(IsThinking || IsAutoPlaying)">
                @(IsThinking ? "Thinking…" : "Step")
            </button>

            @if (!IsAutoPlaying)
            {
                <button class="btn btn-success" @onclick="OnRunClicked" disabled="@IsThinking">
                    ▶ Run
                </button>
            }
            else
            {
                <button class="btn btn-warning" @onclick="OnStopClicked">
                    ■ Stop
                </button>
            }
        </div>
    }

    @if (Game != null && Game.IsGameOver)
    {
        <p class="game-over-text">@Game.Status</p>
    }
</div>

@code {
    [Parameter] public GameState? Game { get; set; }
    [Parameter] public bool IsThinking { get; set; }
    [Parameter] public bool IsAutoPlaying { get; set; }
    [Parameter] public EventCallback OnStepClicked { get; set; }
    [Parameter] public EventCallback OnRunClicked { get; set; }
    [Parameter] public EventCallback OnStopClicked { get; set; }
}
