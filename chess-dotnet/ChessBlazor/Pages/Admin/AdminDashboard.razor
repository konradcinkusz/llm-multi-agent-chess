@page "/admin"
@using ChessBlazor.Models
@using ChessBlazor.Services
@inject AdminApiClient AdminApi
@inject NavigationManager Nav

<PageTitle>Admin Dashboard</PageTitle>

<div class="admin-page">
    <div class="admin-header">
        <h1>Admin Dashboard</h1>
        <p class="subtitle">Platform overview and content management</p>
    </div>

    @if (_loading)
    {
        <div class="loading-spinner">Loading stats...</div>
    }
    else if (_stats != null)
    {
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">@_stats.TotalGames</div>
                <div class="stat-label">Total Games</div>
            </div>
            <div class="stat-card active">
                <div class="stat-value">@_stats.ActiveGames</div>
                <div class="stat-label">Active Games</div>
            </div>
            <div class="stat-card completed">
                <div class="stat-value">@_stats.CompletedGames</div>
                <div class="stat-label">Completed</div>
            </div>
            <div class="stat-card prompts">
                <div class="stat-value">@_stats.TotalPrompts</div>
                <div class="stat-label">LLM Prompts</div>
            </div>
            <div class="stat-card moves">
                <div class="stat-value">@_stats.TotalMoves</div>
                <div class="stat-label">Total Moves</div>
            </div>
            <div class="stat-card players">
                <div class="stat-value">@_stats.PlayerNames.Count</div>
                <div class="stat-label">Players</div>
            </div>
        </div>

        <div class="admin-nav-cards">
            <div class="nav-card" @onclick='() => Nav.NavigateTo("/admin/conversations")'>
                <div class="nav-card-icon">&#x1F4AC;</div>
                <div class="nav-card-title">Conversations</div>
                <div class="nav-card-desc">Browse all game sessions. Filter by player to inspect their activity.</div>
            </div>
            <div class="nav-card" @onclick='() => Nav.NavigateTo("/admin/prompts")'>
                <div class="nav-card-icon">&#x1F4DD;</div>
                <div class="nav-card-title">Prompts</div>
                <div class="nav-card-desc">View all LLM prompts sent by agents. Filter by player or game.</div>
            </div>
        </div>

        @if (_stats.PlayerNames.Count > 0)
        {
            <div class="players-section">
                <h2>Players</h2>
                <div class="player-chips">
                    @foreach (var player in _stats.PlayerNames)
                    {
                        <span class="player-chip" @onclick='() => Nav.NavigateTo($"/admin/conversations?player={Uri.EscapeDataString(player)}") '>
                            @player
                        </span>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="error-msg">Failed to load stats. Is the API running?</div>
    }
</div>

@code {
    private AdminStats? _stats;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try { _stats = await AdminApi.GetStatsAsync(); }
        catch { _stats = null; }
        finally { _loading = false; }
    }
}

<style>
    .admin-page {
        padding: 2rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .admin-header h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .subtitle {
        color: #888;
        margin-bottom: 2rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: #1e1e2e;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 1.25rem;
        text-align: center;
    }

    .stat-card.active  { border-color: #4caf50; }
    .stat-card.completed { border-color: #2196f3; }
    .stat-card.prompts { border-color: #ff9800; }
    .stat-card.moves   { border-color: #9c27b0; }
    .stat-card.players { border-color: #e91e63; }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: #fff;
    }

    .stat-label {
        font-size: 0.8rem;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.25rem;
    }

    .admin-nav-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .nav-card {
        background: #1e1e2e;
        border: 1px solid #444;
        border-radius: 12px;
        padding: 1.5rem;
        cursor: pointer;
        transition: border-color 0.2s, transform 0.1s;
    }

    .nav-card:hover {
        border-color: #888;
        transform: translateY(-2px);
    }

    .nav-card-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .nav-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    .nav-card-desc {
        font-size: 0.85rem;
        color: #aaa;
        line-height: 1.4;
    }

    .players-section h2 {
        font-size: 1.2rem;
        margin-bottom: 0.75rem;
    }

    .player-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .player-chip {
        background: #2a2a3e;
        border: 1px solid #555;
        border-radius: 20px;
        padding: 0.3rem 0.8rem;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background 0.15s;
    }

    .player-chip:hover { background: #3a3a5e; }

    .loading-spinner, .error-msg {
        text-align: center;
        padding: 3rem;
        color: #aaa;
    }
</style>
