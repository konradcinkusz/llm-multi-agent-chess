@page "/admin/prompts"
@using ChessBlazor.Models
@using ChessBlazor.Services
@inject AdminApiClient AdminApi
@inject NavigationManager Nav

<PageTitle>Admin - Prompts</PageTitle>

<div class="admin-page">
    <div class="admin-header">
        <a class="back-link" href="/admin">&#x2190; Dashboard</a>
        <h1>Prompts</h1>
        <p class="subtitle">All LLM prompts sent by chess agents</p>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
        <div class="filter-group">
            <label>Player:</label>
            <select @bind="_selectedPlayer" @bind:after="OnFilterChanged">
                <option value="">All players</option>
                @foreach (var p in _players)
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Game ID:</label>
            <input type="text" @bind="_gameIdInput" @bind:after="OnFilterChanged"
                   placeholder="paste game GUID..." class="game-id-input" />
        </div>

        <button class="btn-clear" @onclick="ClearFilters">Clear</button>
        <button class="btn-refresh" @onclick="LoadPrompts">Refresh</button>
    </div>

    @if (_activeGameId.HasValue || !string.IsNullOrEmpty(_selectedPlayer))
    {
        <div class="active-filters">
            @if (!string.IsNullOrEmpty(_selectedPlayer))
            {
                <span class="filter-tag">
                    Player: @_selectedPlayer
                    <button @onclick='() => { _selectedPlayer = ""; _ = LoadPrompts(); }'>x</button>
                </span>
            }
            @if (_activeGameId.HasValue)
            {
                <span class="filter-tag">
                    Game: @_activeGameId.Value.ToString("D").Substring(0, 8)...
                    <button @onclick='() => { _gameIdInput = ""; _activeGameId = null; _ = LoadPrompts(); }'>x</button>
                </span>
            }
        </div>
    }

    @if (_loading)
    {
        <div class="loading-msg">Loading prompts...</div>
    }
    else if (_prompts.Count == 0)
    {
        <div class="empty-msg">No prompts found. Prompts are captured when LLM agents play moves.</div>
    }
    else
    {
        <div class="prompts-list">
            @foreach (var p in _prompts)
            {
                <div class="prompt-card @(p.Success ? "" : "failed-prompt")">
                    <div class="prompt-header">
                        <div class="prompt-meta-left">
                            <span class="ply-badge">Ply @p.Ply</span>
                            <span class="color-badge @(p.Color == "White" ? "white-badge" : "black-badge")">@p.Color</span>
                            <span class="model-tag">@p.Model</span>
                            <span class="personality-tag">@p.Personality</span>
                            @if (!p.Success) { <span class="fail-tag">FAILED</span> }
                        </div>
                        <div class="prompt-meta-right">
                            @if (!string.IsNullOrEmpty(p.PlayerName))
                            {
                                <span class="player-chip-sm" @onclick='() => FilterByPlayer(p.PlayerName!)'>@p.PlayerName</span>
                            }
                            <span class="game-link" @onclick='() => Nav.NavigateTo($"/admin/conversations?gameId={p.GameId}")'>
                                Game: @p.GameId.ToString("D").Substring(0, 8)...
                            </span>
                            <span class="date-sm">@p.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </div>
                    </div>

                    <div class="prompt-body">
                        <div class="prompt-section">
                            <div class="section-label">PROMPT</div>
                            <pre class="prompt-text">@p.PromptText</pre>
                        </div>

                        @if (!string.IsNullOrEmpty(p.ResponseText))
                        {
                            <div class="prompt-section response-section">
                                <div class="section-label @(p.Success ? "success-label" : "fail-label")">
                                    RESPONSE @(p.Success ? "(valid)" : "(invalid)")
                                </div>
                                <pre class="response-text @(p.Success ? "valid-response" : "invalid-response")">@p.ResponseText</pre>
                            </div>
                        }
                        else if (!p.Success)
                        {
                            <div class="prompt-section response-section">
                                <div class="section-label fail-label">RESPONSE (error - no output)</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(_page <= 1)">&#x2190; Prev</button>
            <span>Page @_page</span>
            <button @onclick="NextPage" disabled="@(_prompts.Count < _pageSize)">Next &#x2192;</button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "player")] public string? PlayerQuery { get; set; }
    [SupplyParameterFromQuery(Name = "gameId")] public string? GameIdQuery { get; set; }

    private List<AdminPromptLogItem> _prompts = new();
    private List<string> _players = new();
    private string _selectedPlayer = "";
    private string _gameIdInput = "";
    private Guid? _activeGameId;
    private bool _loading = true;
    private int _page = 1;
    private const int _pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(PlayerQuery))
            _selectedPlayer = PlayerQuery;

        if (!string.IsNullOrEmpty(GameIdQuery) && Guid.TryParse(GameIdQuery, out var gid))
        {
            _activeGameId = gid;
            _gameIdInput = gid.ToString();
        }

        _players = await AdminApi.GetPlayersAsync();
        await LoadPrompts();
    }

    private async Task LoadPrompts()
    {
        _loading = true;
        try
        {
            _prompts = await AdminApi.GetPromptsAsync(_activeGameId, _selectedPlayer, _page, _pageSize);
        }
        finally { _loading = false; }
    }

    private async Task OnFilterChanged()
    {
        _page = 1;
        if (!string.IsNullOrWhiteSpace(_gameIdInput) && Guid.TryParse(_gameIdInput.Trim(), out var gid))
            _activeGameId = gid;
        else if (string.IsNullOrWhiteSpace(_gameIdInput))
            _activeGameId = null;
        await LoadPrompts();
    }

    private void FilterByPlayer(string name)
    {
        _selectedPlayer = name;
        _page = 1;
        _ = LoadPrompts();
    }

    private async Task ClearFilters()
    {
        _selectedPlayer = "";
        _gameIdInput = "";
        _activeGameId = null;
        _page = 1;
        await LoadPrompts();
    }

    private async Task PrevPage() { if (_page > 1) { _page--; await LoadPrompts(); } }
    private async Task NextPage() { _page++; await LoadPrompts(); }
}

<style>
    .admin-page { padding: 2rem; max-width: 1000px; margin: 0 auto; }
    .back-link { color: #888; text-decoration: none; font-size: 0.9rem; }
    .back-link:hover { color: #ccc; }
    .admin-header h1 { font-size: 1.8rem; font-weight: 700; margin: 0.25rem 0; }
    .subtitle { color: #888; margin-bottom: 1.5rem; }

    .filter-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }
    .filter-group { display: flex; align-items: center; gap: 0.4rem; }
    .filter-group label { color: #aaa; font-size: 0.88rem; white-space: nowrap; }

    .filter-bar select {
        background: #1e1e2e;
        color: #fff;
        border: 1px solid #555;
        border-radius: 6px;
        padding: 0.4rem 0.75rem;
        font-size: 0.88rem;
    }

    .game-id-input {
        background: #1e1e2e;
        color: #fff;
        border: 1px solid #555;
        border-radius: 6px;
        padding: 0.4rem 0.75rem;
        font-size: 0.85rem;
        width: 280px;
        font-family: monospace;
    }

    .btn-refresh, .btn-clear {
        background: #2a2a3e;
        color: #ccc;
        border: 1px solid #555;
        border-radius: 6px;
        padding: 0.4rem 0.9rem;
        cursor: pointer;
        font-size: 0.85rem;
    }
    .btn-clear { border-color: #884444; color: #cc8888; }
    .btn-refresh:hover { background: #3a3a5e; }
    .btn-clear:hover { background: #3a2a2a; }

    .active-filters {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }
    .filter-tag {
        background: #2a2a4e;
        border: 1px solid #555;
        border-radius: 12px;
        padding: 0.2rem 0.7rem;
        font-size: 0.82rem;
        color: #bbb;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .filter-tag button {
        background: none;
        border: none;
        color: #888;
        cursor: pointer;
        padding: 0;
        font-size: 0.85rem;
        line-height: 1;
    }
    .filter-tag button:hover { color: #fff; }

    .prompts-list { display: flex; flex-direction: column; gap: 1rem; }

    .prompt-card {
        background: #1a1a2e;
        border: 1px solid #333;
        border-radius: 10px;
        overflow: hidden;
    }
    .failed-prompt { border-color: #5a2a2a; }

    .prompt-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 1rem;
        background: #13131f;
        border-bottom: 1px solid #2a2a3a;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .prompt-meta-left, .prompt-meta-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .ply-badge {
        background: #2a2a4e;
        color: #9999dd;
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .color-badge {
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .white-badge { background: #2a2a2a; color: #f5f5f5; border: 1px solid #555; }
    .black-badge { background: #111; color: #bbb; border: 1px solid #333; }

    .model-tag {
        background: #1a2a3e;
        color: #5599cc;
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        font-size: 0.78rem;
    }

    .personality-tag {
        background: #1a2a1a;
        color: #66aa66;
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        font-size: 0.78rem;
    }

    .fail-tag {
        background: #3a1a1a;
        color: #f44336;
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .player-chip-sm {
        background: #2a2a4e;
        border: 1px solid #555;
        border-radius: 12px;
        padding: 0.15rem 0.5rem;
        cursor: pointer;
        font-size: 0.78rem;
        color: #bbb;
    }
    .player-chip-sm:hover { background: #3a3a6e; }

    .game-link {
        color: #ff9800;
        cursor: pointer;
        font-size: 0.78rem;
        font-family: monospace;
    }
    .game-link:hover { text-decoration: underline; }

    .date-sm { color: #666; font-size: 0.78rem; }

    .prompt-body { padding: 0.75rem 1rem; }

    .prompt-section { margin-bottom: 0.75rem; }
    .prompt-section:last-child { margin-bottom: 0; }
    .response-section { border-top: 1px dashed #2a2a3a; padding-top: 0.75rem; }

    .section-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: #666;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }
    .success-label { color: #4caf50; }
    .fail-label    { color: #f44336; }

    .prompt-text, .response-text {
        background: #0d0d1a;
        border: 1px solid #222;
        border-radius: 6px;
        padding: 0.75rem;
        font-size: 0.8rem;
        line-height: 1.5;
        font-family: 'Courier New', monospace;
        white-space: pre-wrap;
        word-break: break-word;
        color: #ccc;
        max-height: 240px;
        overflow-y: auto;
        margin: 0;
    }
    .valid-response   { color: #4caf50; }
    .invalid-response { color: #f44336; }

    .pagination {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        font-size: 0.9rem;
        color: #aaa;
    }
    .pagination button {
        background: #2a2a3e;
        color: #bbb;
        border: 1px solid #555;
        border-radius: 6px;
        padding: 0.35rem 0.8rem;
        cursor: pointer;
    }
    .pagination button:disabled { opacity: 0.4; cursor: default; }
    .pagination button:not(:disabled):hover { background: #3a3a5e; }

    .loading-msg, .empty-msg { text-align: center; padding: 3rem; color: #888; }
</style>
