# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Game Configuration
AUTO_PLAY_DELAY=1.0
MOVE_HISTORY_LIMIT=5

# UI Configuration
STREAMLIT_THEME=light
BOARD_STYLE=standard

# Optional: Customize agent defaults
DEFAULT_WHITE_MODEL=gpt-3.5-turbo
DEFAULT_BLACK_MODEL=gpt-3.5-turbo
DEFAULT_WHITE_PERSONALITY=standard
DEFAULT_BLACK_PERSONALITY=aggressive

# Model options for selection
DEFAULT_MODEL=gpt-4o-mini
ALTERNATIVE_MODELS=gpt-4o-mini,gpt-4o,gpt-3.5-turbo,gpt-4

# Development Settings
ENVIRONMENT=development
DEBUG=false
